switch: 3 withCases: #{
    1: printLine("One").
    2: printLine("Two").
    3: printLine("Three").
    4: printLine("Four").
    5: printLine("Five").
    _: printLine("Something").
}.

let: #functionWithSwitch with:{:(Integer)n :: Void |
    switch: n withCases: #{
        1: printLine("One").
        2: printLine("Two").
        3: printLine("Three").
        4: printLine("Four").
        5: printLine("Five").
        _: printLine("Something").
    }.
}.

functionWithSwitch dump.
functionWithSwitch(4).
functionWithSwitch(1).
functionWithSwitch(42).
