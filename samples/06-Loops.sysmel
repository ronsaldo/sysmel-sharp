let: #x mutableWith: 0.

if: x = 0 then: {
    printLine("x isZero")
} else: {
    printLine("x not isZero")
}.

while: (x < 10) do: {
    print("While: "). printLine(x)
} continueWith: (x := x + 1).


x := 0.
do: {
    print("do continue while: "). printLine(x)
} continueWith: (x := x + 1) while: (x < 10).

x := 0.
do: {
    print("Do while: "). printLine(x).
    x := x + 1.
} while: (x < 10).