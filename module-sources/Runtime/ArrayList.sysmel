namespace System definition: {
namespace Collections definition: {

forall(V: Type) ArrayList := class withSuperclass: Object fields: #{
    size: Integer.
    capacity: Integer.
    data: V list.
}.

ArrayList !{
initialize :: Void.
    size := 0.
    capacity := 32.
    data := V list new: capacity.
}.

ArrayList !{
size :: Integer.
    size
}.

let testArrayList := ArrayList(Integer) new.
printLine(testArrayList size).
}.
}.

