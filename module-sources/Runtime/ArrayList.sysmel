namespace System definition: {
namespace Collections definition: {

public:[
forall(V: Type) ArrayList := class withSuperclass: Object fields: #{
    size: Integer.
    capacity: Integer.
    data: V list.
}.
].

ArrayList !{
initialize :: Void.
    size := 0.
    capacity := 16.
    data := V list new: capacity.
}.

ArrayList !{
size :: Integer.
    size
}.

ArrayList !{
increaseCapacity :: Void.
    let newCapacity mutable := capacity*2.
    if: newCapacity < 16 then: {
        newCapacity := 16.
    }.

    let newDataStore := V list new: newCapacity.
    let oldData := data.
    let oldDataSize := size.
    let i mutable := 0.
    while: i < oldDataSize do: {
        newDataStore at: i put: (data at: i)
    } continueWith: (i := i + 1).

    data := newDataStore.
}.

ArrayList !{
add: (V)value :: Void.
    if: size >= capacity then: {
        self increaseCapacity
    }.

    data at: size put: value.
    size := size + 1.
}.

ArrayList !{
at: (Integer)index :: V.
    if: index >= size then: {
        error: "Index out of bounds"
    }.

    data at: index
}.


ArrayList !{
at: (Integer)index put: (V)value :: Void.
    if: index >= size then: {
        error: "Index out of bounds"
    }.

    data at: index put: value
}.

ArrayList !{
AsList :: V list.
    let result mutable := V list new: size.
    let i mutable := 0.
    while: i < size do: {
        result at: i put: (data at: i)
    } continueWith: (i := i + 1).

    result
}.

}.
}.

