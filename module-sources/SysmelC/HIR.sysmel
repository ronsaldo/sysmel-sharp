HIRBuilder !{
call: (HIRValue)function withArguments: (HIRValue list)callArguments resultType: (SysmelType)resultType at: (SourcePosition)sourcePosition :: HIRInstruction.
    let call := HIRCallFunctionInstruction new
        sourcePosition: sourcePosition;
        type: resultType;
        function: function;
        callArguments: callArguments;
        yourself.

    ## TODO: Evaluate compile time expression.
    self addInstruction: call.

    call
}.

HIRCallFunctionInstruction !{
dumpToConsole :: Void.
    write("  ") .write(self toString).
    write(" := call "). write(function toString).
    let i mutable := 0.
    while: (i < callArguments size) do: {
        let argument := callArguments at: i.
        write(" "). write (argument toString)
    } continueWith: (i := i + 1).
    writeLine("").
}.

