namespace SysmelC definition: {
public: [
class HIRValue withSuperclass: Value fields:#{
    type: SysmelType
}.

class HIRConstant withSuperclass: HIRValue fields:#{
}.

class HIRConstantLiteralValue withSuperclass: HIRConstant fields:#{
    literal: Value
}.

class HIRFunctionLocalValue withSuperclass: HIRConstant fields:#{
    name: Symbol.
    index: Integer.
}.

class HIRArgument withSuperclass: HIRFunctionLocalValue fields: #{

}.

class HIRCapture withSuperclass: HIRFunctionLocalValue fields: #{

}.

class HIRInstruction withSuperclass: HIRFunctionLocalValue fields: #{
    previousInstruction: HIRInstruction.
    nextInstruction: HIRInstruction.
}.

class HIRBasicBlock withSuperclass: HIRFunctionLocalValue fields: #{
    previousBlock: HIRBasicBlock.
    nextBlock: HIRBasicBlock.

    firstInstruction: HIRInstruction.
    lastInstruction: HIRInstruction.
}.

class HIRFunction withSuperclass: HIRConstant fields: #{
    name: Symbol.
    arguments: HIRArgument list.
    captures: HIRCapture list.
    firstBlock: HIRBasicBlock.
    lastBlock: HIRBasicBlock.

    enumeratedInstructions: HIRValue list.
    sourceFunction: Value.
}.

class HIRFunctionActivationContext withSuperclass: Object fields: #{
    sourcePosition: SourcePosition.
    instructionPC: Integer.
    pc: Integer.

    instructions: HIRValue list.
    instructionValues: Value list.

    returnValue: Value.
}.

class HIRAllocaInstruction withSuperclass: HIRInstruction fields: #{
    valueType: SysmelType
}.

class HIRBoxDynamicValue withSuperclass: HIRInstruction fields: #{
    value: HIRValue
}.

class HIRUnboxDynamicValue withSuperclass: HIRInstruction fields: #{
    value: HIRValue.
}.

class HIRBranchInstruction withSuperclass: HIRInstruction fields: #{
    destination: HIRBasicBlock
}.

class HIRCallFunctionInstruction withSuperclass: HIRInstruction fields: #{
    function: HIRValue.
    callArguments: HIRValue list.
}.

class HIRConditionalBranchInstruction withSuperclass: HIRInstruction fields: #{
    condition: HIRValue.
    trueDestination: HIRBasicBlock.
    falseDestination: HIRBasicBlock
}.

class HIRReturnValueInstruction withSuperclass: HIRInstruction fields: #{
    valueToReturn: HIRValue
}.

class HIRReturnVoidInstruction withSuperclass: HIRInstruction fields: #{
}.

class HIRSendMessageInstruction withSuperclass: HIRInstruction fields: #{
    receiver: HIRValue.
    selector: Symbol.
    arguments: HIRValue list.
}.

class HIRBuilder withSuperclass: Object fields:#{
    environment: LexicalEnvironment.
    function: HIRFunction.
    basicBlock: HIRBasicBlock.
    allocaBuilder: HIRBuilder.
}.

].

