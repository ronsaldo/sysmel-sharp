## HIRSendMessageInstruction
HIRSendMessageInstruction !{
receiver :: HIRValue.
    receiver
}.

HIRSendMessageInstruction !{
receiver: (HIRValue)newReceiver :: Void.
    receiver := newReceiver
}.

HIRSendMessageInstruction !{
selector :: Symbol.
    selector
}.

HIRSendMessageInstruction !{
selector: (Symbol)newSelector :: Void.
    selector := newSelector
}.

HIRSendMessageInstruction !{
arguments :: HIRValue list.
    arguments
}.

HIRSendMessageInstruction !{
arguments: (HIRValue list)newArguments :: Void.
    arguments := newArguments
}.

HIRSendMessageInstruction !{
dumpToConsole :: Void.
    write("  ") .write(self toString).
    write(" := send "). write(selector).
    let i mutable := 0.
    while: (i < arguments size) do: {
        let argument := arguments at: i.
        write(" "). write (argument toString)
    } continueWith: (i := i + 1).
    writeLine("").
}.

HIRBuilder !{
send: (Symbol)selector to: (HIRValue)receiver withArguments: (HIRValue list)messageArguments resultType: (SysmelType)resultType at: (SourcePosition)sourcePosition :: HIRInstruction.
    let messageSend := HIRSendMessageInstruction new
        sourcePosition: sourcePosition;
        receiver: receiver;
        selector: selector;
        arguments: messageArguments;
        type: resultType;
        yourself.

    self addInstruction: messageSend.

    messageSend
}.

HIRSendMessageInstruction !{
evaluateInActivationContext: (HIRFunctionActivationContext)activationContext :: Void.
    let receiverValue := receiver getValueInEvaluationContext: activationContext.
    let argumentValues := Value list new: arguments size.
    let i mutable := 0.
    while: (i < arguments size) do: {
        let argumentValue := (arguments at: i)  getValueInEvaluationContext: activationContext.
        argumentValues at: i put: argumentValue
    } continueWith: (i := i + 1).

    let result := receiverValue sysmelPerform: selector withArguments: argumentValues.
    activationContext setCurrentInstructionValue: result
}.
}