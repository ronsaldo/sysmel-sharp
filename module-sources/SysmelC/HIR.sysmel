}.

HIRReturnValueInstruction !{
dumpToConsole :: Void.
    write("  returnValue: "). writeLine(valueToReturn toString)
}.

HIRBuilder !{
returnValue: (HIRValue)valueToReturn at: (SourcePosition)sourcePosition :: HIRReturnValueInstruction.
    let return := HIRReturnValueInstruction new
        sourcePosition: sourcePosition;
