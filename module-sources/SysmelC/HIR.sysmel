name: (Symbol)newName :: Void.
    name := newName
}.

HIRFunction !{
arguments :: HIRArgument list.
    arguments
}.

HIRFunction !{
arguments: (HIRArgument list)newArguments :: Void.
    arguments := newArguments
}.

HIRFunction !{
captures :: HIRCapture list.
    captures
}.

HIRFunction !{
captures: (HIRCapture list)newCaptures :: Void.
    captures := newCaptures
}.

HIRFunction !{
firstBlock :: HIRBasicBlock.
    firstBlock
}.

HIRFunction !{
firstBlock: (HIRBasicBlock)newFirstBlock :: Void.
    firstBlock := newFirstBlock
}.

HIRFunction !{
lastBlock :: HIRBasicBlock.
    lastBlock
}.

HIRFunction !{
lastBlock: (HIRBasicBlock)newLastBlock :: Void.
    lastBlock := newLastBlock
}.

HIRFunction !{
addBasicBlock: (HIRBasicBlock)newBasicBlock :: Void.
    if: nil == firstBlock then: {
        firstBlock := lastBlock := newBasicBlock
    } else: {
        lastBlock nextBlock: newBasicBlock.
        newBasicBlock previousBlock: lastBlock.
        lastBlock := newBasicBlock
    }
}.

let InstructionArrayList := System Collections ArrayList(HIRValue).

HIRFunction !{
enumerateInstructions :: HIRValue list.
    if: nil ~~ enumeratedInstructions then: {
        return: enumeratedInstructions
    }.

    let instructionList := InstructionArrayList new.

    ## Arguments
    {
        let i mutable := 0.
        while: i < arguments size do: {
            let argument := arguments at: i.
            argument index: instructionList size.
            instructionList add: argument.
        } continueWith:(i := i + 1)
    }.

    ## Captures
    {
        let i mutable := 0.
        while: i < captures size do: {
            let capture := captures at: i.
            capture index: instructionList size.
            instructionList add: capture.
        } continueWith:(i := i + 1)
    }.

    ## Basic blocks.
    {
        let blockPosition mutable := firstBlock.
        while: (nil ~~ blockPosition) do: {
            blockPosition index: instructionList size.
            instructionList add: blockPosition.

            ## Instructions
            let instructionPosition mutable := blockPosition firstInstruction.
            while: (nil ~~ instructionPosition) do: {
                instructionPosition index: instructionList size.
                instructionList add: instructionPosition.
            } continueWith: (instructionPosition := instructionPosition nextInstruction).
        } continueWith: (blockPosition := blockPosition nextBlock).
    }.

    enumeratedInstructions := instructionList asList.
}.

HIRFunction !{
dumpToConsole :: Void.
    self enumerateInstructions.

    if: nil ~~ name then: {
        printLine(name)
    }.
    writeLine("{").

    ## Arguments
    {
        let i mutable := 0.
        while: i < arguments size do: {
            let argument := arguments at: i.
            argument dumpToConsole.
        } continueWith:(i := i + 1)
    }.

    ## Captures
    {
        let i mutable := 0.
        while: i < captures size do: {
            let capture := captures at: i.
            capture dumpToConsole.
        } continueWith:(i := i + 1)
    }.

    ## Basic blocks
    let position mutable := firstBlock.
    while: nil ~~ position do: {
        position dumpToConsole
    } continueWith: (position := position nextBlock).
    writeLine("}").
}.

HIRFunction !{
evaluateWithArguments: (Value list)argumentValues andCaptures: (Value list)captureValues :: Value.
    if: nil ~~ sourceFunction then: {
        sourceFunction ensureAnalysis
    }.

    let instructions := self enumerateInstructions.

    assert: arguments size = argumentValues size.
    assert: captures size = captureValues size.

    let activationContext := HIRFunctionActivationContext new
        initializeWithInstructions: instructions andSourcePositions: sourcePosition;
        setCallArguments: argumentValues andCaptures: captureValues;
        yourself.

    activationContext pc: firstBlock index.
    activationContext evaluateInstructions
}.

HIRFunction !{
evaluateWithArguments: (Value list)argumentValues :: Value.
    self evaluateWithArguments: argumentValues andCaptures: (Value list new: 0)
}.

## HIRFunctionActivationContext
HIRFunctionActivationContext !{
initializeWithInstructions: (HIRValue list) newList andSourcePositions: (SourcePosition) newSourcePosition :: Void.
    sourcePosition := newSourcePosition.
    instructions := newList.

    let instructionCount := instructions size.
    instructionValues := Value list new: instructionCount.
    let voidValue := VoidValue uniqueInstance.
    let i mutable := 0.
    while: (i < instructionCount) do: {
        instructionValues at: i put: voidValue
    } continueWith:( i := i + 1)
}.

## HIRFunctionActivationContext
HIRFunctionActivationContext !{
setCallArguments: (Value list)callArguments andCaptures: (Value list)callCaptures :: Void.
    ## Arguments
    {
        let i mutable := 0.
        while: i < callArguments size do: {
            instructionValues at: i put: (callArguments at: i)
        } continueWith: (i := i + 1).
    }.

    ## Captures
    {
        let i mutable := 0.
        while: i < callCaptures size do: {
            instructionValues at: callArguments size + i put: (callCaptures at: i)
        } continueWith: (i := i + 1).
    }
}.

HIRFunctionActivationContext !{
pc :: Integer.
    pc
}.

HIRFunctionActivationContext !{
pc: (Integer)newPC.
    pc := newPC
}.

HIRFunctionActivationContext !{
instructionValues :: Value list.
    instructionValues
}.

HIRFunctionActivationContext !{
setCurrentInstructionValue: (Value)valueToSet :: Void.
    instructionValues at: instructionPC put: valueToSet
}.

HIRFunctionActivationContext !{
evaluateInstructions :: Value.
    let instructionCount := instructions size.
    while: (pc < instructionCount) do: {
        ## Fetch the instruction
        instructionPC := pc.
        pc := pc + 1.
        let instruction := instructions at: instructionPC.

        ## Evaluate the instruction
        instruction evaluateInActivationContext: self.

        ## Return
        if: nil ~~ returnValue then: {
            return: returnValue
        }.
    }.

    error: "Reached beyond the end of a function instructions."
}.

HIRFunctionActivationContext !{
returnValue: (Value)valueToReturn :: Void.
    returnValue := valueToReturn
}.

