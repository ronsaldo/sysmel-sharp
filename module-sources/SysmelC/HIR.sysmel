## HIRBasicBlock
HIRBasicBlock !{
previousBlock :: HIRBasicBlock.
    previousBlock
}.

HIRBasicBlock !{
previousBlock: (HIRBasicBlock)newBlock :: Void.
    previousBlock := newBlock
}.

HIRBasicBlock !{
nextBlock :: HIRBasicBlock.
    nextBlock
}.

HIRBasicBlock !{
nextBlock: (HIRBasicBlock)newBlock :: Void.
    nextBlock := newBlock
}.

HIRBasicBlock !{
firstInstruction :: HIRInstruction.
    firstInstruction
}.

HIRBasicBlock !{
firstInstruction: (HIRInstruction)newInstruction :: Void.
    firstInstruction := newInstruction
}.

HIRBasicBlock !{
lastInstruction :: HIRInstruction.
    lastInstruction
}.

HIRBasicBlock !{
lastInstruction: (HIRInstruction)newInstruction :: Void.
    lastInstruction := newInstruction
}.

HIRBasicBlock !{
addInstruction: (HIRInstruction)newInstruction :: Void.
    if: nil == lastInstruction then: {
        firstInstruction := lastInstruction := newInstruction
    } else: {
        lastInstruction nextInstruction: newInstruction.
        newInstruction previousInstruction: lastInstruction.
        lastInstruction := newInstruction
    }
}.

HIRBasicBlock !{
toString :: String.
    if: nil ~~ name then: {
        "%" -- name asString -- "." -- index asString
    }
    else: {
        "%" -- index asString
    }
}.

HIRBasicBlock !{
isLastTerminator :: Boolean.
    (lastInstruction ~~ nil) && (lastInstruction isTerminator)
}.

HIRBasicBlock !{
dumpToConsole :: Void.
    write(self toString). writeLine(":").

    let currentPosition mutable := firstInstruction.
    while: nil ~~ currentPosition do: {
        currentPosition dumpToConsole
    } continueWith: (currentPosition := currentPosition nextInstruction).
}.

HIRBasicBlock !{
evaluateInActivationContext: (HIRFunctionActivationContext)activationContext :: Void.
    ## Nothing is required here
}.

