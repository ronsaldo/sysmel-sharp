namespace SysmelC definition: {
public: [
class HIRValue withSuperclass: Value fields:#{
    type: SysmelType
}.

class HIRConstant withSuperclass: HIRValue fields:#{
}.

class HIRConstantLiteralValue withSuperclass: HIRConstant fields:#{
    literal: Value
}.

class HIRFunctionLocalValue withSuperclass: HIRConstant fields:#{
    name: Symbol.
    index: Integer.
}.

class HIRArgument withSuperclass: HIRFunctionLocalValue fields: #{

}.

class HIRCapture withSuperclass: HIRFunctionLocalValue fields: #{

}.

class HIRInstruction withSuperclass: HIRFunctionLocalValue fields: #{
    previousInstruction: HIRInstruction.
    nextInstruction: HIRInstruction.
}.

class HIRBasicBlock withSuperclass: HIRFunctionLocalValue fields: #{
    previousBlock: HIRBasicBlock.
    nextBlock: HIRBasicBlock.

    firstInstruction: HIRInstruction.
    lastInstruction: HIRInstruction.
}.

class HIRFunction withSuperclass: HIRConstant fields: #{
    name: Symbol.
    arguments: HIRArgument list.
    captures: HIRCapture list.
    firstBlock: HIRBasicBlock.
    lastBlock: HIRBasicBlock.
}.

class HIRAllocaInstruction withSuperclass: HIRInstruction fields: #{
    valueType: SysmelType
}.

class HIRBranchInstruction withSuperclass: HIRInstruction fields: #{
    destination: HIRBasicBlock
}.

class HIRCallFunctionInstruction withSuperclass: HIRInstruction fields: #{
    function: HIRValue.
    callArguments: HIRValue list.
}.

class HIRConditionalBranchInstruction withSuperclass: HIRInstruction fields: #{
    condition: HIRValue.
    trueDestination: HIRBasicBlock.
    falseDestination: HIRBasicBlock
}.

class HIRReturnValueInstruction withSuperclass: HIRInstruction fields: #{
    valueToReturn: HIRValue
}.

class HIRReturnVoidInstruction withSuperclass: HIRInstruction fields: #{
}.

class HIRBuilder withSuperclass: Object fields:#{
    environment: Environment.
    function: HIRFunction.
    basicBlock: HIRBasicBlock.
    allocaBuilder: HIRBuilder.
}.

].

## HIR Value
HIRValue !{
type :: SysmelType.
    type
}.

HIRValue !{
type: (SysmelType)aType :: Void.
    type := aType
}.

HIRValue !{
toString :: String.
    "an HIR Value"
}.

## HIRConstantLiteralValue
HIRConstantLiteralValue !{
literal :: Value.
    literal
}.

HIRConstantLiteralValue !{
literal: (Value)newLiteral :: Void.
    literal := newLiteral
}.

## HIRFunctionLocalValue
HIRFunctionLocalValue !{
name :: Symbol.
    name
}.

HIRFunctionLocalValue !{
name: (Symbol)aSymbol :: Void.
    name := aSymbol
}.

HIRFunctionLocalValue !{
index :: Integer.
    index
}.

HIRFunctionLocalValue !{
index: (Integer)anInteger :: Void.
    index := anInteger
}.

## HIRInstruction
HIRInstruction !{
previousInstruction :: HIRInstruction.
    previousInstruction
}.

HIRInstruction !{
previousInstruction: (HIRInstruction)newPrevious :: Void.
    previousInstruction := newPrevious
}.

HIRInstruction !{
nextInstruction :: HIRInstruction.
    nextInstruction
}.

HIRInstruction !{
nextInstruction: (HIRInstruction)newNext :: Void.
    nextInstruction := newNext
}.

HIRInstruction !{
isTerminator :: Boolean.
    false
}.

HIRInstruction !{
toString :: String.
    "%" -- index asString
}.

HIRInstruction !{
dumpToConsole :: Void.
    write("  "). writeLine(self toString) 
}.

## HIRBasicBlock
HIRBasicBlock !{
previousBlock :: HIRBasicBlock.
    previousBlock
}.

HIRBasicBlock !{
previousBlock: (HIRBasicBlock)newBlock :: Void.
    previousBlock := newBlock
}.

HIRBasicBlock !{
nextBlock :: HIRBasicBlock.
    nextBlock
}.

HIRBasicBlock !{
nextBlock: (HIRBasicBlock)newBlock :: Void.
    nextBlock := newBlock
}.

HIRBasicBlock !{
firstInstruction :: HIRInstruction.
    firstInstruction
}.

HIRBasicBlock !{
firstInstruction: (HIRInstruction)newInstruction :: Void.
    firstInstruction := newInstruction
}.

HIRBasicBlock !{
lastInstruction :: HIRInstruction.
    lastInstruction
}.

HIRBasicBlock !{
lastInstruction: (HIRInstruction)newInstruction :: Void.
    lastInstruction := newInstruction
}.

HIRBasicBlock !{
addInstruction: (HIRInstruction)newInstruction :: Void.
    if: nil == lastInstruction then: {
        firstInstruction := lastInstruction := newInstruction
    } else: {
        lastInstruction nextInstruction: newInstruction.
        newInstruction previousInstruction: lastInstruction.
        lastInstruction := newInstruction
    }
}.

HIRBasicBlock !{
toString :: String.
    if: nil ~~ name then: {
        "%" -- name asString -- "." -- index asString
    }
    else: {
        "%" -- index asString
    }
}.

HIRBasicBlock !{
dumpToConsole :: Void.
    write(self toString). writeLine(":").

    let currentPosition mutable := firstInstruction.
    while: nil ~~ currentPosition do: {
        currentPosition dumpToConsole
    } continueWith: (currentPosition := currentPosition nextInstruction).
}.

## HIRArgument
HIRArgument !{
toString :: String.
    if: nil ~~ name then: {
        "%" -- name asString -- "." -- index asString
    }
    else: {
        "%" -- index asString
    }
}.

HIRArgument !{
dumpToConsole :: Void.
    write("  "). write(self toString). writeLine(" := argument")
}.

## HIRCapture
HIRCapture !{
toString :: String.
    if: nil ~~ name then: {
        "%" -- name asString -- "." -- index asString
    }
    else: {
        "%" -- index asString
    }
}.

HIRCapture !{
dumpToConsole :: Void.
    write("  "). write(self toString). writeLine(" := capture")
}.

## HIRFunction
HIRFunction !{
name :: Symbol.
    name
}.

HIRFunction !{
name: (Symbol)newName :: Void.
    name := newName
}.

HIRFunction !{
arguments :: HIRArgument list.
    arguments
}.

HIRFunction !{
arguments: (HIRArgument list)newArguments :: Void.
    arguments := newArguments
}.

HIRFunction !{
captures :: HIRCapture list.
    captures
}.

HIRFunction !{
captures: (HIRCapture list)newCaptures :: Void.
    captures := newCaptures
}.

HIRFunction !{
firstBlock :: HIRBasicBlock.
    firstBlock
}.

HIRFunction !{
firstBlock: (HIRBasicBlock)newFirstBlock :: Void.
    firstBlock := newFirstBlock
}.

HIRFunction !{
lastBlock :: HIRBasicBlock.
    lastBlock
}.

HIRFunction !{
lastBlock: (HIRBasicBlock)newLastBlock :: Void.
    lastBlock := newLastBlock
}.

HIRFunction !{
addBasicBlock: (HIRBasicBlock)newBasicBlock :: Void.
    if: nil == firstBlock then: {
        firstBlock := lastBlock := newBasicBlock
    } else: {
        lastBlock nextBlock: newBasicBlock.
        newBasicBlock previousBlock: lastBlock.
        lastBlock := newBasicBlock
    }
}.

HIRFunction !{
dumpToConsole :: Void
    if: nil ~~ name then: {
        printLine(name)
    }.
    writeLine("{").

    ## Arguments
    {
        let i mutable := 0.
        while: i < arguments size do: {
            let argument := arguments at: i.
            argument dumpToConsole.
        } continueWith:(i := i + 1)
    }.

    ## Captures
    {
        let i mutable := 0.
        while: i < captures size do: {
            let capture := captures at: i.
            capture dumpToConsole.
        } continueWith:(i := i + 1)
    }.

    ## Basic blocks
    let position mutable := firstBlock.
    while: nil ~~ position do: {
        position dumpToConsole
    } continueWith: (position := position nextBlock).
    writeLine("}").
}.

## HIRBuilder
HIRBuilder !{
environment :: Environment.
    environment
}.

HIRBuilder !{
environment: (Environment)newEnvironment :: Void.
    environment := newEnvironment
}.

HIRBuilder !{
function :: HIRFunction.
    function
}.

HIRBuilder !{
function: (HIRFunction)newFunction :: Void.
    function := newFunction
}.

HIRBuilder !{
basicBlock :: HIRBasicBlock.
    basicBlock
}.

HIRBuilder !{
basicBlock: (HIRBasicBlock)newBasicBlock :: Void.
    basicBlock := newBasicBlock
}.

HIRBuilder !{
allocaBuilder :: HIRBuilder.
    allocaBuilder
}.

HIRBuilder !{
allocaBuilder: (HIRBuilder)newAllocaBuilder :: Void.
    allocaBuilder := newAllocaBuilder
}.

HIRBuilder !{
addInstruction: (HIRInstruction)newInstruction :: Void.
    basicBlock addInstruction: newInstruction
}.

## Alloca instruction
HIRAllocaInstruction !{
valueType :: SysmelType.
    valueType
}.

HIRAllocaInstruction !{
valueType: (SysmelType)newValueType.
    valueType := newValueType
}.

HIRAllocaInstruction !{
dumpToConsole :: Void.
    write("  "). write(self toString). writeLine(" := alloca")
}.

HIRBuilder !{
alloca: (SysmelType)valueType type: (SysmelType) type at: (SourcePosition)sourcePosition :: HIRAllocaInstruction.
    let alloca := HIRAllocaInstruction new
        sourcePosition: sourcePosition;
        valueType: valueType;
        type: type;
        yourself.

    self addInstruction: alloca.

    alloca
}.

## Branch instruction
HIRBranchInstruction !{
destination :: HIRBasicBlock.
    destination
}.

HIRBranchInstruction !{
destination: (HIRBasicBlock)newDestination :: Void.
    destination := newDestination
}.

HIRBranchInstruction !{
isTerminator :: Boolean.
    true
}.

HIRBranchInstruction !{
dumpToConsole :: Void.
    write("  branch "). writeLine(destination toString)
}.


HIRBuilder !{
branch: (HIRBasicBlock)newDestination at: (SourcePosition)sourcePosition :: HIRBranchInstruction.
    let branch := HIRBranchInstruction new
        sourcePosition: sourcePosition;
        destination: newDestination;
        yourself.

    self addInstruction: branch.

    branch
}.

## Call function instruction
HIRCallFunctionInstruction !{
function :: HIRValue.
    function
}.

HIRCallFunctionInstruction !{
function: (HIRValue)newFunction :: Void.
    function := newFunction
}.

HIRCallFunctionInstruction !{
callArguments :: HIRValue list.
    callArguments
}.

HIRCallFunctionInstruction !{
callArguments: (HIRValue list)newArguments :: Void.
    callArguments := newArguments
}.

HIRBuilder !{
call: (HIRFunction)function withArguments: (HIRValue list)callArguments at: (SourcePosition)sourcePosition :: HIRInstruction.
    let call := HIRCallFunctionInstruction new
        sourcePosition: sourcePosition;
        function: function;
        callArguments: callArguments;
        yourself.

    ## TODO: Evaluate compile time expression.
    self addInstruction: call.

    call
}.

## HIRConditionalBranchInstruction
HIRConditionalBranchInstruction!{
condition :: HIRValue.
    condition
}.

HIRConditionalBranchInstruction!{
condition: (HIRValue)newCondition.
    condition := newCondition
}.

HIRConditionalBranchInstruction!{
trueDestination :: HIRBasicBlock.
    trueDestination
}.

HIRConditionalBranchInstruction!{
trueDestination: (HIRBasicBlock)newDestination.
    trueDestination := newDestination
}.

HIRConditionalBranchInstruction!{
falseDestination :: HIRBasicBlock.
    falseDestination
}.

HIRConditionalBranchInstruction!{
falseDestination: (HIRBasicBlock)newDestination.
    falseDestination := newDestination
}.

HIRConditionalBranchInstruction !{
isTerminator :: Boolean.
    true
}.

HIRBuilder !{
conditionalBranch: (HIRValue)condition trueDestination: (HIRBasicBlock)trueDestination falseDestination: (HIRBasicBlock)falseDestination at: (SourcePosition)sourcePosition :: HIRConditionalBranchInstruction.
    let branch := HIRConditionalBranchInstruction new
        sourcePosition: sourcePosition;
        condition: condition;
        trueDestination: trueDestination;
        falseDestination: falseDestination;
        yourself.

    self addInstruction: branch.

    branch
}.

## HIRReturnValueInstruction
HIRReturnValueInstruction !{
valueToReturn :: HIRValue.
    valueToReturn
}.

HIRReturnValueInstruction !{
valueToReturn: (HIRValue)newReturnValue :: Void.
    valueToReturn := newReturnValue
}.

HIRReturnValueInstruction !{
