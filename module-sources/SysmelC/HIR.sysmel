## HIRReturnVoidInstruction
HIRReturnVoidInstruction !{
isTerminator :: Boolean.
    true
}.

HIRReturnVoidInstruction !{
dumpToConsole :: Void.
    write("  returnVoid")
}.

HIRBuilder !{
returnVoidAt: (SourcePosition)sourcePosition :: HIRReturnVoidInstruction.
    let return := HIRReturnVoidInstruction new
        sourcePosition: sourcePosition;
        yourself.

    self addInstruction: return.

