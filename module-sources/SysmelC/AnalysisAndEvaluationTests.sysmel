namespace SysmelC definition: {
function evaluateSourceString(sourceString: String) => Value := {
    let sourceCode := makeSourceCodeForString(sourceString).
    let parseTree := Parser new parseSourceCode: sourceCode.
    let systemEnvironment := NamespaceEnvironment withParent: EmptyEnvironment new namespace: CompilationContext current globalNamespace.
    let environment := LexicalEnvironment withParent: systemEnvironment.
    parseTree analyzeAndEvaluateInEnvironment: environment
}.

## testAssociation
{
    let value := evaluateSourceString("1 : 2").
    assert: value key asInteger = 1.
    assert: value value asInteger = 2.
}.

## testEmptyDictionaryExpression
{
    let value := evaluateSourceString("#{}").
    assert: value isImmutableDictionaryValue.
    assert: value elements size = 0.
}.

## testDictionaryExpression
{
    let value := evaluateSourceString("#{first: 1}").
    assert: value isImmutableDictionaryValue.
    assert: value elements size = 1.
    assert: (value elements at: 0) key value = #first.
    assert: (value elements at: 0) value value = 1.
}.

## testDictionaryExpression2
{
    let value := evaluateSourceString("#{first: 1. Second: 2}").
    assert: value isImmutableDictionaryValue.
    assert: value elements size = 2.

    assert: (value elements at: 0) key value = #first.
    assert: (value elements at: 0) value value = 1.

    assert: (value elements at: 1) key value = #Second.
    assert: (value elements at: 1) value value = 2.
}.

## testDictionaryExpression3
{
    let value := evaluateSourceString("#{first: 1. Second: 2. #third : 3}").
    assert: value isImmutableDictionaryValue.
    assert: value elements size = 3.

    assert: (value elements at: 0) key value = #first.
    assert: (value elements at: 0) value value = 1.

    assert: (value elements at: 1) key value = #Second.
    assert: (value elements at: 1) value value = 2.

    assert: (value elements at: 2) key value = #third.
    assert: (value elements at: 2) value value = 3.
}.

## testIdentifierReference
{
    let value := evaluateSourceString("Int32").
    assert: value = CompilationContext current Int32Type
}.

## testIfExpression
{
    let value := evaluateSourceString("if: true then: 1 else: 2").
    assert: value type = CompilationContext current LargeIntegerType.
    assert: value value = 1.
}.

## testIfExpression2
{
    let value := evaluateSourceString("if: false then: 1 else: 2").
    assert: value type = CompilationContext current LargeIntegerType.
    assert: value value = 2.
}.

## testIfExpression3
{
    let value := evaluateSourceString("if: true then: 1").
    assert: value type = CompilationContext current LargeIntegerType.
    assert: value value = 1.
}.

## testIfExpression4
{
    let value := evaluateSourceString("if: false then: 1").
    assert: value type = CompilationContext current VoidType.
}.

## testLexicalBlock
{
    let value := evaluateSourceString("{42}").
    assert: value value = 42
}.

## testLiteralCharacter
{
    let value := evaluateSourceString("'A'").
    assert: value value = 'A' asInteger
}.

## testLiteralInteger
{
    let value := evaluateSourceString("42").
    assert: value value = 42
}.

## testLiteralFloat
{
    let value := evaluateSourceString("42.5").
    assert: value value = 42.5
}.

## testLiteralString
{
    let value := evaluateSourceString("\"Hello World\"").
    assert: value value = "Hello World"
}.

## testLiteralSymbol
{
    let value := evaluateSourceString("#mySymbol").
    assert: value value = #mySymbol.
}.

## testEmptyList
{
    let value := evaluateSourceString("[]").
    assert: value elements size = 0.
}.

## testList
{
    let value := evaluateSourceString("[1 . 2]").
    assert: value elements size = 2.
    assert: (value elements at: 0) value = 1.
    assert: (value elements at: 1) value = 2.
}.

## testLetMacro
{
    let value := evaluateSourceString("let: #x with: 42").
    assert: value value = 42
}.

## testLetMacro2
{
    let value := evaluateSourceString("let: #x with: 42. x + 3").
    assert: value value = 45
}.

## testLetMutableMacro
{
    let value := evaluateSourceString("let: #var mutableWith: 42").
    assert: value loadValue value = 42.
}.


## testLetMutableMacro2
{
    let value := evaluateSourceString("let: #var mutableWith: 42. var").
    assert: value loadValue value = 42.
}.

## testLetMutableMacro3
{
    let value := evaluateSourceString("let: #var mutableWith: 42. var := 5").
    assert: value loadValue value = 5.
}.

## testLetMutableMacro4
{
    let value := evaluateSourceString("let: #var mutableWith: 42. var + 5").
    assert: value value = 47.
}.

## testLetMetabuilder
{
    let value := evaluateSourceString("let test := 42").
    assert: value asInteger = 42
}.

## testLetMetabuilder2
{
    let value := evaluateSourceString("let test type: Integer := 42").
    assert: value asInteger = 42
}.

## testLetMutableMetabuilder
{
    let value := evaluateSourceString("let test mutable := 42").
    assert: value loadValue asInteger = 42.
}.

## testLetMutableMetabuilder2
{
    let value := evaluateSourceString("let test mutable := 42. test").
    assert: value loadValue asInteger = 42.
}.

## testLetMutableMetabuilder3
{
    let value := evaluateSourceString("let test mutable := 42. test := 5").
    assert: value loadValue asInteger = 5.
}.

## testLetMutableMetabuilder4
{
    let value := evaluateSourceString("let test mutable := 42. test + 5").
    assert: value value = 47.
}.

## testMessageSend
{
    let value := evaluateSourceString("5 negated").
    assert: value asInteger = -5.
}.

## testBinaryExpression
{
    let value := evaluateSourceString("1 + 2").
    assert: value asInteger = 3.
}.

## testDoWhile
{
    let value := evaluateSourceString("let: #i mutableWith: 0. do: {i := i + 1} while: (i < 10). i").
    assert: value loadValue value = 10.
}.

## testWhileLoop
{
    let value := evaluateSourceString("let: #i mutableWith: 0. while: i < 10 do: {i := i + 1}. i").
    assert: value loadValue value = 10.
}.

## testWhileContinueLoop
{
    let value := evaluateSourceString("let: #i mutableWith: 0. while: i < 10 do: {} continueWith: {i := i + 1}. i").
    assert: value loadValue value = 10.
}.

## testNamespace
{
    let value := evaluateSourceString("namespace: #TestNamespace definition: {}").
    assert: value isNamespace.
    assert: value name = #TestNamespace.
}.

## testNamespaceMetabuilder
{
    let value := evaluateSourceString("namespace TestMetaBuilderNamespace definition: {}").
    assert: value isNamespace.
    assert: value name = #TestMetaBuilderNamespace.
}.

## testEnumType
{
    let value := evaluateSourceString("Enum: #TestEnum withBaseType: Integer values: #{
		First: 1.
		Second: 2.
        Third: .
	}").

    assert: value isEnumType.
    assert: value namesAndValues size = 3.
    assert: (value namesAndValues at: #First) value asInteger = 1.
    assert: (value namesAndValues at: #Second) value asInteger = 2.
    assert: (value namesAndValues at: #Third) value asInteger = 3.
}.

## testEnumTypeValueAccess
{
    let value := evaluateSourceString("Enum: #TestEnum withBaseType: Integer values: #{
		First: 1.
		Second: 2.
        Third: .
	}.
    
    TestEnum Third
    ").

    assert: value isEnumValue.
    assert: value value asInteger = 3.
}.

## testEnumTypeValueAccess2
{
    let value := evaluateSourceString("Enum: #TestEnum withBaseType: Integer values: #{
		First: 1.
		Second: 2.
        Third: .
	}.
    
    TestEnum Third value
    ").
    assert: value value = 3
}.

## testEnumTypeMetaBuilder
{
    let value := evaluateSourceString("enum TestEnum baseType: Integer values: #{
		First: 1.
		Second: 2.
        Third: .
	}").

    assert: value isEnumType.
    assert: value namesAndValues size = 3.
    assert: (value namesAndValues at: #First) value value = 1.
    assert: (value namesAndValues at: #Second) value value = 2.
    assert: (value namesAndValues at: #Third) value value = 3.
}.

## testEnumTypeMetaBuilder
{
    let value := evaluateSourceString("enum TestEnum baseType: Integer values: #{
		First: 1.
		Second: 2.
        Third: .
	}.
    
    TestEnum Third"
    ).

    assert: value isEnumValue.
    assert: value value value = 3.
}.

## testRecordType
{
    let value := evaluateSourceString("Record: #MyDynamicPair withFields: #{first: Dynamic. second: Dynamic}").
    assert: value isRecordType.
    assert: value fields size = 2.

    assert: (value fields at: 0) name = #first.
    assert: (value fields at: 0) type = CompilationContext current DynamicType.

    assert: (value fields at: 1) name = #second.
    assert: (value fields at: 1) type = CompilationContext current DynamicType.
}.

## testRecordTypeMetabuilder
{
    let value := evaluateSourceString("record MyDynamicPair withFields: #{first: Dynamic. second: Dynamic}").
    assert: value isRecordType.
    assert: value fields size = 2.

    assert: (value fields at: 0) name = #first.
    assert: (value fields at: 0) type = CompilationContext current DynamicType.

    assert: (value fields at: 1) name = #second.
    assert: (value fields at: 1) type = CompilationContext current DynamicType.
}.

## testRecord
{
    let value := evaluateSourceString("
		Record: #MyDynamicPair withFields: #{first: Dynamic. second: Dynamic}.
		
		MyDynamicPair(1. 2)
    ").
    assert: value isRecordValue.
    assert: value elements size = 2.
    assert: (value elements at: 0) asInteger = 1.
    assert: (value elements at: 1) asInteger = 2.
}.

## testRecord
{
    let value := evaluateSourceString("
		Record: #MyDynamicPair withFields: #{first: Dynamic. second: Dynamic}.
		
		MyDynamicPair#{first: 5. second: 4}
    ").
    assert: value isRecordValue.
    assert: value elements size = 2.
    assert: (value elements at: 0) asInteger = 5.
    assert: (value elements at: 1) asInteger = 4.
}.

## testRecord field access
{
    let value := evaluateSourceString("
		Record: #MyDynamicPair withFields: #{first: Dynamic. second: Dynamic}.
		
		MyDynamicPair#{first: 5. second: 4} first
    ").
    assert: value asInteger = 5.
}.

}