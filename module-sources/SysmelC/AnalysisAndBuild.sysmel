namespace SysmelC definition: {
Value !{
analyzeAndBuildWith: (HIRBuilder)aHIRBuilder :: HIRValue.
    aHIRBuilder addLiteral: self at: sourcePosition
}.

HIRValue !{
analyzeAndBuildWith: (HIRBuilder)aHIRBuilder :: HIRValue.
    self
}.

Value !{
analyzeAndBuildWith: (HIRBuilder)aHIRBuilder expectedType: (SysmelType)expectedType :: HIRValue.
    let value := self analyzeAndBuildWith: aHIRBuilder.
    self castHIRValue: value toExpectedType: expectedType with: aHIRBuilder
}.

Value !{
analyzeAndBuildWithDecayedType: (HIRBuilder)aHIRBuilder :: HIRValue.
    let value := self analyzeAndBuildWith: aHIRBuilder.
    if: value type isReferenceType then: {
        error: "TODO"
    }.
    value
}.

Value !{
castHIRValue: (HIRValue)value toExpectedType: (SysmelType)expectedType with: (HIRBuilder)builder :: HIRValue.
    let valueType := value type.

    if: nil == expectedType then: {
        if: valueType isReferenceType then: {
            error: "TODO: load pointer"
            ##return: (builder loadPointer: value at: sourcePosition)
        }.

        return: value
    }.

    if: (expectedType isSatisfiedByType: valueType) then: {
        return: value
    }.

    if: value type isReferenceType then: {
        let loadedRef := builder loadFrom: value at: sourcePosition.
        return: (self castHIRValue: loadedRef toExpectedType: expectedType with: builder).
    }.

    if: value type isDynamicType then: {
        return: (builder unboxDynamicValue: value withType: expectedType at: sourcePosition)
    }.
    if: expectedType isDynamicType then: {
        return: (builder boxDynamicValue: value at: sourcePosition)
    }.

    error: sourcePosition printString -- ": Expected an expression with type " -- expectedType printString -- " instead of " -- valueType printString
}.

ParseTreeNode !{
analyzeAndBuildWith: (HIRBuilder)aHIRBuilder :: HIRValue.
    printLine(self).
    error: self sourcePosition printString -- ": Subclass responsibility"
}.

Value !{
asArgumentValue :: ArgumentValue.
    error: "Not an argument value"
}.

ArgumentValue !{
asArgumentValue :: ArgumentValue.
    self
}.

ParseTreeArgumentDefinitionNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: ArgumentValue.
    let type mutable type: SysmelType := CompilationContext current DynamicType.
    if: nil ~~ typeExpression then: {
        type := (typeExpression analyzeAndEvaluateInEnvironment: environment) asType
    }.

    let argumentValue := ArgumentValue new
        sourcePosition: sourcePosition;
        name: name;
        type: type;
        yourself.
    if: nil ~~ name then: {
        environment setSymbol: name binding: argumentValue
    }.
    argumentValue
}.

Value !{
analyzeAndBuildAssignment: (ParseTreeAssignmentNode)assignment with: (HIRBuilder)builder :: HIRValue.
    let storageValue := self.
    if: storageValue type isReferenceType then: {
        let valueToStore := assignment value analyzeAndBuildWith: builder expectedType: storageValue type baseType.
        let storagePointer := storageValue analyzeAndBuildWith: builder.

        builder store: valueToStore in: storagePointer at: assignment sourcePosition.
        return: storagePointer
    }.

    error: "Not assignable value"
}.

ParseTreeAssignmentNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    let storageValue := storage analyzeAndBuildWith: aBuilder.
    storageValue analyzeAndBuildAssignment: self with: aBuilder
}.

ParseTreeBinaryExpressionSequenceNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    self expandAsMessageSendSequence analyzeAndBuildWith: aBuilder
}.

ParseTreeFunctionalDependentTypeNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: FunctionType.
    let argumentEnvironment := LexicalEnvironment withParent: environment.
    let argumentCount := argumentDefinitions size.
    let argumentValues := ArgumentValue list new: argumentCount.
    let argumentIndex mutable := 0.
    while: (argumentIndex < argumentCount) do: {
        let argumentDefinition := argumentDefinitions at: argumentIndex.
        let argumentValue := (argumentDefinition analyzeAndEvaluateInEnvironment: argumentEnvironment) asArgumentValue.

        argumentValue index: argumentIndex.
        argumentValues at: argumentIndex put: argumentValue
    } continueWith: (argumentIndex := argumentIndex + 1).

    let hasMacroContextAsFirstArgument := false. ##(argumentValues size >= 1) && (argumentValues first isMacroContextArgument).
    let resultType mutable type: SysmelType := CompilationContext current DynamicType.
    if: nil ~~ resultTypeExpression then: {
        resultType := (resultTypeExpression analyzeAndEvaluateInEnvironment: argumentEnvironment) asType
    }.

    FunctionType new
        argumentDefinitions: argumentValues;
        resultTypeExpression: resultType;
        yourself
}.

ParseTreeBlockClosureNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let functionTypeValue := functionType analyzeAndEvaluateInEnvironment: environment.
    let functionValue := FunctionValue new
        sourcePosition: sourcePosition;
        type: functionTypeValue;
        functionType: functionTypeValue;
        definitionEnvironment: environment;
        definitionBody: body;
        yourself.
    functionValue ensureAnalysis.
    functionValue
}.

ParseTreeIfSelectionNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    let trueDestination := HIRBasicBlock new sourcePosition: sourcePosition; name: #ifTrue; yourself.
    let falseDestination := HIRBasicBlock new sourcePosition: sourcePosition; name: #ifFalse; yourself.
    let mergeDestination := HIRBasicBlock new sourcePosition: sourcePosition; name: #ifMerge; yourself.

    let conditionValue := condition analyzeAndBuildWith: builder expectedType: CompilationContext current BooleanType.
    builder conditionalBranch: conditionValue trueDestination: trueDestination falseDestination: falseDestination at: sourcePosition.

    ## True destination
    let trueBuilder := builder copyWithBasicBlock: trueDestination.
    trueBuilder function addBasicBlock: trueDestination.

    let trueResult mutable type: HIRValue := nil.
    if: nil ~~ trueExpression then: {
        trueResult := trueExpression analyzeAndBuildWithDecayedType: builder
    }.

    ## False destination
    let falseBuilder := builder copyWithBasicBlock: falseDestination.
    falseBuilder function addBasicBlock: falseDestination.

    let falseResult mutable type: HIRValue := nil.
    if: nil ~~ falseExpression then: {
        falseResult := falseExpression analyzeAndBuildWithDecayedType: builder
    }.

    ## Merge destination.
    builder function addBasicBlock: mergeDestination.
    builder basicBlock: mergeDestination.

    let mergedResult mutable := builder getVoidLiteralAt: sourcePosition.

    if: (nil ~~ trueResult) && (nil ~~ falseResult) then: {
        let trueType := trueResult type.
        let falseType := falseResult type.
        if: trueType isVoidType not && (trueType = falseType) then: {
            let phiNode := builder phi: trueType name: #ifMergePhi at: sourcePosition.
            
            trueBuilder phi: phiNode source: trueResult at: sourcePosition.
            falseBuilder phi: phiNode source: falseResult at: sourcePosition.

            mergedResult := phiNode.            
        }.
    }.

    trueBuilder branch: mergeDestination at: sourcePosition.
    falseBuilder branch: mergeDestination at: sourcePosition.

    mergedResult
}.

Value !{
analyzeAndBuildIdentifierReference: (ParseTreeIdentifierReferenceNode)identifierReference with: (HIRBuilder)aBuilder :: HIRValue.
    aBuilder addLiteral: self at: identifierReference sourcePosition
}.

FunctionalValue !{
analyzeAndBuildIdentifierReference: (ParseTreeIdentifierReferenceNode)identifierReference with: (HIRBuilder)aBuilder :: HIRValue.
    HIRImportedFunction new
        sourcePosition: sourcePosition;
        functional: self;
        type: self type;
        yourself
}.

HIRValue !{
analyzeAndBuildIdentifierReference: (ParseTreeIdentifierReferenceNode)identifierReference with: (HIRBuilder)aBuilder :: HIRValue.
    self
}.

ParseTreeIdentifierReferenceNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    let foundValue := aBuilder environment lookupRecursively: value.
    if: nil == foundValue then: {
        error: "Failed to find identifier for " -- value printString
    }.

    foundValue analyzeAndBuildIdentifierReference: self with: aBuilder
}.

SysmelType !{
analyzeAndBuildApplication: (Value)functional withNode: (ParseTreeApplicationNode)applicationNode andBuilder: (HIRBuilder)aBuilder :: HIRValue.
    #*if: self = CompilationContext current DynamicType then: {
        let dynamicArgumentValues := applicationNode arguments collect: {:each |
            let argumentValue type: Value := each.
            aBuilder castValue: (argumentValue analyzeAndBuildWith: aBuilder) toExpectedType: CompilationContext current DynamicType
        }.

        return: (aBuilder makeFunction: functional applicationWithArguments: dynamicArgumentValues resultType: CompilationContext current DynamicType)
    }.

    error: applicationNode sourcePosition printString --": Error: not an applicable functional type."*#
    error: "SysmelType TODO"
}.

Value !{
analyzeAndBuildApplication: (ParseTreeApplicationNode)applicationNode with: (HIRBuilder)aBuilder :: HIRValue.
    self type analyzeAndBuildApplication: self withNode: applicationNode andBuilder: aBuilder
}.

FunctionalValue !{
analyzeAndBuildApplication: (ParseTreeApplicationNode)applicationNode with: (HIRBuilder)aBuilder :: HIRValue.
    if: self isMacro then: {
        let macroContext := MacroContext new
                sourcePosition: applicationNode sourcePosition;
                environment: aBuilder environment;
                yourself.

        let macroArguments := Value list new: 1 + applicationNode arguments size.
        macroArguments at: 0 put: macroContext.
        let i mutable := 0.
        while: (i < applicationNode arguments size) do: {
            macroArguments at: i + 1 put: (applicationNode arguments at: i)
        } continueWith: (i := i + 1).

        let macroResult := self evaluateWithArguments: macroArguments.
        return: (macroResult analyzeAndBuildWith: aBuilder)
    }.

    super analyzeAndBuildApplication: applicationNode with: aBuilder
}.

HIRImportedFunction !{
analyzeAndBuildApplication: (ParseTreeApplicationNode)applicationNode with: (HIRBuilder)aBuilder :: HIRValue.
    functional analyzeAndBuildApplication: applicationNode with: aBuilder
}.

ParseTreeApplicationNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    let functionalValue mutable := self functional analyzeAndBuildWith: aBuilder.
    if: functionalValue type isReferenceType then: {
        error: "TODO".
        ##functionalValue := aBuilder makeLoadFrom: functionalValue type: functionalValue type baseType.
    }.
    functionalValue analyzeAndBuildApplication: self with: aBuilder
}.

## Literals

ParseTreeLiteralBooleanNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (BooleanValue new value: value; yourself) at: sourcePosition
}.

ParseTreeLiteralCharacterNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (IntegerValue new value: value asInteger; type: CompilationContext current CharacterType; yourself) at: sourcePosition
}.

ParseTreeLiteralFloatNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (FloatValue new value: value; type: CompilationContext current FloatType; yourself) at: sourcePosition
}.

ParseTreeLiteralIntegerNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (IntegerValue new value: value; type: CompilationContext current LargeIntegerType; yourself) at: sourcePosition
}.

ParseTreeLiteralStringNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (StringValue new value: value; type: CompilationContext current StringType; yourself) at: sourcePosition
}.

ParseTreeLiteralSymbolNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    builder addLiteral: (SymbolValue new value: value; type: CompilationContext current SymbolType; yourself) at: sourcePosition
}.

Value !{
analyzeAndBuildMessage: (ParseTreeMessageSendNode)messageSend selector: (Symbol)selectorValue builder: (HIRBuilder)aBuilder :: HIRValue.
    let receiverValue mutable := self.
    let receiverValueIsSuper := self isSuperArgumentValue.
    
    if: receiverValue type isReferenceType then: {
        receiverValue := aBuilder loadFrom: (receiverValue analyzeAndBuildWith: aBuilder) at: messageSend sourcePosition.
    }.

    if: selectorValue = #yourself then: {
        return: receiverValue
    }.

    if: receiverValue type isDynamicType then: {
        let dynamicCallArguments := HIRValue list new: messageSend arguments size.
        {
            let i mutable := 0.
            while: (i < dynamicCallArguments size) do: {
                let argumentNode := (messageSend arguments at: i).
                let argument := argumentNode analyzeAndBuildWithDecayedType: aBuilder.
                let boxedArgument := aBuilder boxDynamicValue: argument at: argumentNode sourcePosition.
                dynamicCallArguments at: i put: boxedArgument.
            } continueWith: (i := i +1).
        }.
        
        let foundMethodOrField := receiverValue type lookupSelector: selectorValue.
        if: nil ~~ foundMethodOrField then: {
            let functionType := foundMethodOrField type asFunctionType.
            let callArguments := HIRValue list new: dynamicCallArguments size + 1.
            callArguments at: 0 put: (aBuilder addLiteral: receiverValue at: messageSend receiver sourcePosition).
            let i mutable := 0.
            while: (i < dynamicCallArguments size) do: {
                callArguments at: i + 1 put: (dynamicCallArguments at: i)
            } continueWith: (i < dynamicCallArguments size).

            let calledMethod := foundMethodOrField analyzeAndBuildWith: aBuilder.
            printLine(calledMethod).
            error: "TODO".
            let callResultType := functionType computeResultTypeWithHIRArguments: callArguments.
            let callResult := aBuilder call:calledMethod withArguments: callArguments resultType: callResultType at: messageSend sourcePosition.
            return: callResult
        }.

        let calledReceiver := receiverValue analyzeAndBuildWith: aBuilder.
        let sendResult := aBuilder send: selectorValue to: calledReceiver withArguments: dynamicCallArguments resultType: CompilationContext current DynamicType at: messageSend sourcePosition.
        return: sendResult
    }.

    let foundMethodOrField := receiverValue lookupValueSelector: selectorValue.
    if: nil == foundMethodOrField then: {
        error: messageSend sourcePosition printString --  ": Failed to find method with selector " -- selectorValue printString -- " in a value of type " -- receiverValue type printString
    }.

    if: foundMethodOrField isMacro then: {
        let macroContext := MacroContext new
            sourcePosition: messageSend sourcePosition;
            environment: aBuilder environment;
            yourself.

        let argumentCount := messageSend arguments size.
        let macroArguments := Value list new: 2 + argumentCount.
        macroArguments at: 0 put: macroContext.
        macroArguments at: 1 put: messageSend receiver.

        let i mutable := 0.
        while: (i < argumentCount) do: {
            macroArguments at: 2 + i put: (messageSend arguments at: i)
        } continueWith: (i := i + 1).

        let macroResult := foundMethodOrField evaluateWithArguments: macroArguments.
        return: (macroResult analyzeAndBuildWith: aBuilder)
    }.

    if: foundMethodOrField isFieldDefinition then: {
        error: "TODO".
        #*
        assert: messageSend arguments size = 0.
        let extractedValue := aBuilder makeExtractFrom: receiverValue fieldWithDefinition: foundMethodOrField asFieldDefinition.
        return: extractedValue
        *#
    }.

    let functionType := foundMethodOrField type asFunctionType.
    let callArgumentsArray := HIRValue list new: 1 + messageSend arguments size.
    let destCallIndex mutable := 0.
    let addArgumentValue := {:(Value)argument :: Void |
        let argumentIndex := destCallIndex.
        let argumentDefinition type: ArgumentValue := functionType argumentDefinitions at: argumentIndex.
        let expectedType := argumentDefinition type.
        let castedValue := argument analyzeAndBuildWith: aBuilder expectedType: expectedType.
        callArgumentsArray at: destCallIndex put: castedValue.
        destCallIndex := destCallIndex + 1
    }.

    if: receiverValueIsSuper then: {
        addArgumentValue(receiverValue asSelfArgument).
    } else: {
        addArgumentValue(receiverValue).
    }.
    ##messageSend arguments do: {:each :: Void | addArgumentValue(each)}.
    let i mutable := 0.
    while: (i < messageSend arguments size) do: {
        addArgumentValue(messageSend arguments at: i)
    } continueWith: (i := i + 1).

    let resultType := functionType computeResultTypeWithHIRArguments: callArgumentsArray.
    if: receiverValue type isBehaviorType && receiverValueIsSuper not && receiverValue type isFinal not then: {
        if: (nil == foundMethodOrField) || foundMethodOrField isFinal not then: {
            let sendResult := aBuilder send: selectorValue receiverAndArguments: callArgumentsArray resultType: resultType at: messageSend sourcePosition.
            return: sendResult
        }
    }.

    let foundMethodValue := foundMethodOrField analyzeAndBuildWith: aBuilder.
    let callResult := aBuilder call: foundMethodValue withArguments: callArgumentsArray resultType: resultType at: messageSend sourcePosition.
    callResult
}.

#*
EnumType !{
analyzeAndBuildMessage: (ParseTreeMessageSendNode)messageSend selector: (Symbol)selectorValue builder: (Builder)aBuilder :: Value.
    let enumValue type: EnumValue := namesAndValues atOrNil: selectorValue.
    if: nil ~~ enumValue then: {
        return: enumValue
    }.
    super analyzeAndBuildMessage: messageSend selector: selectorValue builder: aBuilder
}.
*#

ParseTreeMessageSendNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    let receiverValue := self receiver analyzeAndBuildWith: aBuilder.
    let selectorValue := self selector analyzeAndEvaluateInEnvironment: aBuilder environment.
    receiverValue analyzeAndBuildMessage: self selector: selectorValue asSymbolValue builder: aBuilder
}.

ParseTreeSequenceNode !{
analyzeAndBuildWith: (HIRBuilder)aBuilder :: HIRValue.
    let result mutable type: HIRValue := aBuilder addLiteral: VoidValue uniqueInstance at: sourcePosition.
    let elementsCount := elements size. 
    let i mutable := 0.
    while: (i < elementsCount) do: {
        result := (elements at: i) analyzeAndBuildWith: aBuilder
    } continueWith: (i := i + 1).

    result
}.

## ParseTreeVariableDefinitionNode
ParseTreeVariableDefinitionNode !{
analyzeAndBuildWith: (HIRBuilder)builder :: HIRValue.
    let name := nameExpression analyzeAndEvaluateInEnvironment: builder environment withExpectedType: CompilationContext current SymbolType.
    let typeValue mutable type: SysmelType := nil.
    if: nil ~~ optionalTypeExpression then: {
        let typeExpressionValue := optionalTypeExpression analyzeAndEvaluateInEnvironmentWithDecayedType: builder environment.
        typeValue := typeExpressionValue asType
    }.
    
    let initialValue mutable type: HIRValue := nil.
    if: nil ~~ optionalInitialValue then: {
        initialValue := optionalInitialValue analyzeAndBuildWith: builder expectedType: typeValue
    }.

    if: isMutable then: {
        let valueType := initialValue type.
        let referenceType := CompilationContext current getOrCreateReferenceType: valueType.
        let allocaValue := builder allocaBuilder alloca: valueType type: referenceType at: sourcePosition.

        builder store: initialValue in: allocaValue at: sourcePosition.

        builder environment setSymbol: name asSymbolValue binding: allocaValue.
        return: allocaValue
    }.

    builder environment setSymbol: name asSymbolValue binding: initialValue.
    initialValue
}.


}.