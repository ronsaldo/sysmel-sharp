namespace SysmelC definition: {
public: [
class Value withSuperclass: Object fields:#{
    sourcePosition: SourcePosition
}.
].

let SymbolHashtable := System Collections Dictionary(Symbol . Value).

public: [
class SysmelType withSuperclass: Value fields:#{
}.

class DerivedType withSuperclass: SysmelType fields:#{
    baseType: SysmelType.
}.

class ListType withSuperclass: DerivedType fields:#{
}.

class ListValue withSuperclass: Value fields:#{
    elements: Value list.
    type: SysmelType
}.

class PointerLikeType withSuperclass: DerivedType fields:#{
}.

class PointerType withSuperclass: PointerLikeType fields:#{
}.

class ReferenceType withSuperclass: PointerLikeType fields:#{
}.

class SimpleType withSuperclass: SysmelType fields:#{
    methodDictionary: SymbolHashtable
}.

class NominalType withSuperclass: SimpleType fields:#{
    name: Symbol.
}.

class IntegerType withSuperclass: NominalType fields:#{
    valueSize: Integer.
    valueAlignment: Integer.
    valueIsPointer: Boolean.
    isSigned: Boolean.
}.

class TypeUniverse withSuperclass: SimpleType fields:#{
    index: Integer
}.

].

Value !{
sourcePosition :: SourcePosition.
    sourcePosition
}.

Value !{
sourcePosition: (SourcePosition)newSourcePosition :: Void.
    sourcePosition := newSourcePosition
}.

Value !{
type :: SysmelType.
    error: "Subclass responsibility.".
}.

## SysmelType
SysmelType !{
isReferenceLikeType :: Boolean.
    false
}.

## DerivedType
DerivedType !{
baseType :: SysmelType.
    baseType
}.

DerivedType !{
baseType: (SysmelType)newBaseType :: Void.
    baseType := newBaseType
}.

## ListValue
ListValue !{
elements :: Value list.
    elements
}.

ListValue !{
elements: (Value list) newElements :: Void.
    elements := newElements.
}.

ListValue !{
type :: SysmelType.
    type
}.

ListValue !{
type: (SysmelType) newType :: Void.
    type := newType.
}.

NominalType !{
defaultValue :: Value.
    UndefinedValue uniqueInstance
}.

## Nominal type
NominalType !{
name :: Symbol.
    name
}.

NominalType !{
name: (Symbol)newName :: Void.
    name := newName
}.

## Integer type
IntegerType !{
valueSize :: Integer.
    valueSize
}.

IntegerType !{
valueSize: (Integer)newValueSize :: Void.
    valueSize := newValueSize
}.

IntegerType !{
valueAlignment :: Integer.
    valueAlignment
}.

IntegerType !{
valueAlignment: (Integer)newValueAlignment :: Void.
    valueAlignment := newValueAlignment
}.

IntegerType !{
isSigned :: Boolean.
    isSigned
}.

IntegerType !{
isSigned: (Boolean)newIsSigned :: Void.
    isSigned := newIsSigned
}.

## TypeUniverse
TypeUniverse !{
index :: Integer.
    index
}.

TypeUniverse !{
index: (Integer)newIndex :: Void.
    newIndex
}.

}