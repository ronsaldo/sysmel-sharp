## Behavior type
BehaviorType !{
initialize :: Void.
    super initialize.
    fields := FieldDefinition list new.
    allFields := fields.
    methodDictionary := SymbolHashtable new.
    methodList := ValueArrayList new.
    isFinal := false.
}.

Value !{
asBehaviorType :: BehaviorType.
    error: "Not a behavior type"
}.

BehaviorType !{
asBehaviorType :: BehaviorType.
    self
}.

BehaviorType !{
isFinal :: Boolean.
    isFinal
}.

Value !{
isBehaviorType :: Boolean.
    false
}.

BehaviorType !{
isBehaviorType :: Boolean.
    true
}.

BehaviorType !{
superclass :: BehaviorType.
    superclass
}.

BehaviorType !{
superclass: (BehaviorType)newSuperclass :: Void.
    superclass := newSuperclass
}.

BehaviorType !{
fields :: FieldDefinition list.
    fields
}.

BehaviorType !{
fields: (FieldDefinition list)newFields :: Void.
    fields := newFields
}.

BehaviorType !{
setFields: (FieldDefinition list)newFields :: Void.
    fields := newFields.
    allFields := fields.
    if: nil ~~ superclass then: {
        allFields := superclass allFields -- fields.
    }.

    self buildFieldsByValue.
}.

BehaviorType !{
buildFieldsByValue :: Void.
    fieldsByValue := SymbolFieldHashtable new.
    let fieldCount := allFields size.
    let i mutable := 0.
    while: i < fieldCount do: {
        let field := allFields at: i.
        field index: i.
        fieldsByValue at: field name put: field.
    } continueWith: (i := i + 1).
}.

BehaviorType !{
allFields :: FieldDefinition list.
    allFields
}.

BehaviorType !{
withSelector: (Symbol)selector addMethod: (FunctionalValue)method :: Void.
    methodDictionary at: selector put: method.
    methodList add: method.
}.

BehaviorType !{
lookupSelector: (Symbol)selector :: Value.
    if: (methodDictionary includesKey: selector) then: {
        return: (methodDictionary at: selector)
    }.

    if: nil ~~ superclass then: {
        return: (superclass lookupSelector: selector)
    }.

    nil
}.

BehaviorType !{
isSatisfiedByType: (SysmelType) aType :: Boolean.
    if: self == aType then: { return: true }.
    if: aType = CompilationContext current UndefinedObjectType then: { return: true }.
    if: aType isBehaviorType not then: {return: false}.
    let otherBehavior := aType asBehaviorType.
    if: nil == otherBehavior superclass then: {return: false}.
    self isSatisfiedByType: otherBehavior superclass
}.

BehaviorType !{
basicNewObject :: ClassInstanceValue.
    let fieldCount := allFields size.
    let instanceFields := Value list new: fieldCount.
    let i mutable := 0.
    while: (i < fieldCount) do: {
        instanceFields at: i put: (allFields at: i) type defaultValue
    } continueWith: (i := i + 1).
    
    ClassInstanceValue new
        elements: instanceFields;
        type: self;
        yourself
}.

BehaviorType !{
newObject :: ClassInstanceValue.
    let object := self basicNewObject.
    object sysmelPerform: #initialize withArguments: Value list new.
    object
}.

