SysmelType !{
isVoidType :: Boolean.
    self == CompilationContext current VoidType
}.

SysmelType !{
=> resultTypeExpression :: FunctionType.
    if: self == CompilationContext current VoidType then: {
        return: (FunctionType new
            argumentDefinitions: ArgumentValue list new;
            resultTypeExpression: resultTypeExpression;
            yourself)
    }.

    let argumentValueList := ArgumentValue list new: 1.
    argumentValueList at: 0 put: (ArgumentValue new type: self; index: 0; yourself).

    FunctionType new
        argumentDefinitions: argumentValueList;
        resultTypeExpression: resultTypeExpression;
        yourself
}.

TupleType !{
=> resultTypeExpression :: FunctionType.
    let argumentCount := elements size.
    let argumentDefinitions := ArgumentValue list new: argumentCount.
    let i mutable := 0.
    while: (i < argumentCount) do: {
        let argument := ArgumentValue new
            type: (elements at: i);
            index: i;
            yourself.
        argumentDefinitions at: i put: argument
    } continueWith:(i := i + 1).

    FunctionType new
        argumentDefinitions: argumentDefinitions;
        resultTypeExpression: resultTypeExpression;
        yourself
}.

