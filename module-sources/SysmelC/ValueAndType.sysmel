namespace SysmelC definition: {
public: [
class Value withSuperclass: Object fields:#{
    sourcePosition: SourcePosition
}.

class SysmelType withSuperclass: Value fields:#{
}.

class FieldDefinition withSuperclass: Value fields:#{
    name: Symbol.
    index: Integer.
    type: SysmelType.
}.
].

let ValueArrayList := System Collections ArrayList(Value).
let SymbolHashtable := System Collections Dictionary(Symbol . Value).
let SymbolFieldHashtable := System Collections Dictionary(Symbol . FieldDefinition).

public: [

class AssociationType withSuperclass: SysmelType fields:#{
    key: SysmelType.
    value: SysmelType.
    methodDictionary: SymbolHashtable.
}.

class AssociationValue withSuperclass: Value fields:#{
    key: Value.
    value: Value.
    type: AssociationType.
}.

class DerivedType withSuperclass: SysmelType fields:#{
    baseType: SysmelType.
}.

class ListType withSuperclass: DerivedType fields:#{
}.

class ListValue withSuperclass: Value fields:#{
    elements: Value list.
    type: SysmelType
}.

class MutableBoxType withSuperclass: DerivedType fields:#{
}.

class MutableValueBox withSuperclass: Value fields: #{
    currentValue: Value.
    type: SysmelType
}.


class PointerLikeType withSuperclass: DerivedType fields:#{
}.

class PointerType withSuperclass: PointerLikeType fields:#{
}.

class ReferenceType withSuperclass: PointerLikeType fields:#{
}.

class PointerLikeValue withSuperclass: Value fields:#{
    storage: Value.
    fieldIndex: Integer.
    type: SysmelType.
}.

class PointerValue withSuperclass: PointerLikeValue fields:#{
}.

class ReferenceValue withSuperclass: PointerLikeValue fields:#{
}.

class BehaviorType withSuperclass: SysmelType fields:#{
    superclass: BehaviorType.
    fields: FieldDefinition list.

    allFields: FieldDefinition list.
    fieldsByValue: SymbolFieldHashtable.
    methodDictionary: SymbolHashtable.
    methodList: ValueArrayList.

    isFinal: Boolean.
}.

class ClassType withSuperclass: BehaviorType fields:#{
    name: Symbol.
    type: BehaviorType.
}.
class MetaclassType withSuperclass: BehaviorType fields:#{
    thisClass: ClassType
}.

class ClassInstanceValue withSuperclass: Value fields:#{
    elements: Value list.
    type: BehaviorType.
}.

class EnumType withSuperclass: SysmelType fields:#{
    name: Symbol.
    baseType: SysmelType.
    namesAndValues: SymbolHashtable.
    methodDictionary: SymbolHashtable.
}.

class EnumValue withSuperclass: Value fields:#{
    value: Value.
    name: Symbol.
    type: EnumType.
}.

class SimpleType withSuperclass: SysmelType fields:#{
    methodDictionary: SymbolHashtable
}.

class NominalType withSuperclass: SimpleType fields:#{
    name: Symbol.
}.

class RecordType withSuperclass: SimpleType fields:#{
    name: Symbol.
    fields: FieldDefinition list.
    fieldsByName: SymbolFieldHashtable.
}.

class RecordValue withSuperclass: Value fields:#{
    elements: Value list.
    type: RecordType
}.

class TupleType withSuperclass: SimpleType fields:#{
    elements: SysmelType list.
}.

class IntegerType withSuperclass: NominalType fields:#{
    valueSize: Integer.
    valueAlignment: Integer.
    valueIsPointer: Boolean.
    isSigned: Boolean.
}.

class TypeUniverse withSuperclass: SimpleType fields:#{
    index: Integer
}.

class ArgumentValue withSuperclass: Value fields: #{
    name: Symbol.
    type: SysmelType.
    index: Integer
}.

class SuperArgumentValue withSuperclass: Value fields: #{
    selfArgument: ArgumentValue.
    type: SysmelType.
}.

class FunctionType withSuperclass: SysmelType fields:#{
    argumentDefinitions: ArgumentValue list.
    resultTypeExpression: Value.
    typeUniverse: TypeUniverse
}.

class FunctionalValue withSuperclass: Value fields:#{
    type: FunctionType.
    name: Symbol.
    isCompileTimeFunction: Boolean.
    isMacro: Boolean.
    isFinal: Boolean.
}.

class PrimitiveFunctionValue withSuperclass: FunctionalValue fields: #{
    primitiveName: Symbol.
    implementation: (Value list) => Value.
}.

class ImmutableDictionaryType withSuperclass: SysmelType fields: #{
    associationType: AssociationType.
}.

class ImmutableDictionaryValue withSuperclass: Value fields: #{
    elements: AssociationValue list.
    type: ImmutableDictionaryType
}.

].

