FunctionalValue !{
evaluateWithArguments: (Value list)arguments :: Value.
    error: "Subclass responsibility."
}.

FunctionalValue !{
sanitizeArguments: (Value list)arguments :: Value list.
    let argumentCount := type argumentDefinitions size.
    let argumentDefinitions := type argumentDefinitions.
    let sanitizedArguments := Value list new: argumentCount.

    let i mutable := 0.
    while: (i < argumentCount) do: {
        let argumentDefinition := argumentDefinitions at: i.
        let argumentValue := arguments at: i.
        let castedValue := argumentValue castAnalyzedAndEvaluatedValue: argumentValue toExpectedType: argumentDefinition type.
        sanitizedArguments at: i put: castedValue.        
    } continueWith: (i := i + 1).
    
    sanitizedArguments
}.

