RecordType!{
buildFieldsByNameTable :: Void.
    fieldsByName := SymbolFieldHashtable new.
    let fieldCount := fields size.
    let i mutable := 0.
    while: (i < fieldCount) do: {
        let field := fields at: i.
        let fieldName := field name.
        if: nil ~~ fieldName then: {
            fieldsByName at: fieldName put: field
        }
    } continueWith:(i := i + 1).
}. 

RecordType !{
lookupFieldName: (Symbol)aFieldName :: Value.
    fieldsByName atOrNil: aFieldName
}.

RecordType !{
lookupSelector: (Symbol)selector :: Value.
    let selectorToCheck := selector withoutSuffix: ":".
    let foundField := self lookupFieldName: selectorToCheck.
    if: nil ~~ foundField then: {
        return: foundField 
    }.

    super lookupSelector: selector
}.

