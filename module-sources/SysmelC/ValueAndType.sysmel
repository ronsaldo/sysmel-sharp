EnumType !{
lookupSelector: (Symbol)selector :: Value.
    self validMethodDictionary atOrNil: selector
}.

EnumType !{
validMethodDictionary :: SymbolHashtable.
    if: nil ~~ methodDictionary then: {
        return: methodDictionary
    }.

    methodDictionary := SymbolHashtable new.

    methodDictionary at: #value put: (self => baseType withSelector: #value makePrimitiveWithPrefix: "Enum" doing: {
        :(Value list)arguments :: Value |
        let enumValue := (arguments at: 0) asEnumValue.
        enumValue value
    }).

    methodDictionary
}.


