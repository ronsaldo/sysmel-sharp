FunctionType !{
withSelector: (Symbol)selector makePrimitiveWithPrefix: (String)primitiveNamePrefix doing: ((Value list) => Value)implementation :: PrimitiveFunctionValue.
    PrimitiveFunctionValue new
        type: self;
        name: selector;
        isMacro: false;
        primitiveName: (primitiveNamePrefix -- selector asString) asSymbol;
        implementation: implementation;
        yourself
}.

FunctionType !{
withSelector: (Symbol)selector makeCompileTimePrimitiveWithPrefix: (String)primitiveNamePrefix doing: ((Value list) => Value)implementation :: PrimitiveFunctionValue.
    PrimitiveFunctionValue new
        type: self;
        name: selector;
        isMacro: false;
        isCompileTimeFunction: true;
        primitiveName: (primitiveNamePrefix -- selector asString) asSymbol;
        implementation: implementation;
        yourself
}.

FunctionType !{
withSelector: (Symbol)selector makePrimitiveMacroWithPrefix: (String)primitiveNamePrefix doing: ((Value list) => Value)implementation :: PrimitiveFunctionValue.
    PrimitiveFunctionValue new
        type: self;
        name: selector;
        isMacro: true;
        primitiveName: (primitiveNamePrefix -- selector asString) asSymbol;
        implementation: implementation;
        yourself
}.

