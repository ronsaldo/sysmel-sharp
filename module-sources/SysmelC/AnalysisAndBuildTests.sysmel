namespace SysmelC definition: {
function evaluateSourceString(sourceString: String) => Value := {
    let sourceCode := makeSourceCodeForString(sourceString).
    let parseTree := Parser new parseSourceCode: sourceCode.
    let systemEnvironment := NamespaceEnvironment withParent: EmptyEnvironment new namespace: CompilationContext current globalNamespace.
    let environment := LexicalEnvironment withParent: systemEnvironment.
    parseTree analyzeAndEvaluateInEnvironment: environment
}.

## testLiteral
{
    let blockClosure := evaluateSourceString("{:: Integer | 42}").
    ##blockClosure dumpToConsole.
    let evalResult := blockClosure evaluateWithArguments: Value list new.
    assert: evalResult value = 42.
}.

## testIdentity
{
    let blockClosure := evaluateSourceString("{:x | x}").
    ##blockClosure dumpToConsole.
    let evalResult := blockClosure evaluateWithArguments: ((Value list new: 1)
                                                        at: 0 put: (IntegerValue new value: 42; type: CompilationContext current LargeIntegerType; yourself);
                                                        yourself).
    assert: evalResult value = 42.
}.

## testIdentityEval
{
    let evalResult := evaluateSourceString("{:x | x}(42)").
    assert: evalResult asInteger = 42.
}.

## testBlockClosure3
{
    let value := evaluateSourceString("{:(Integer)x :: Integer| x}(42)").
    assert: value asInteger = 42.
}.

## testBlockClosure4
{
    let value := evaluateSourceString("{:x :: Integer| x} (42)").
    assert: value asInteger = 42.
}.

## testBlockClosure5
{   
    let value := evaluateSourceString("{:(Integer)x | x}(42)").
    assert: value asInteger = 42.
}.

## testBlockClosureDynamicAdd
{
    let value := evaluateSourceString("{:x | x + 5 }").
    assert: value isFunctionValue.
    ## value dumpToConsole
}.

## testBlockClosureDynamicAdd2
{
    let value := evaluateSourceString("{:x | x + 5 }(7)").
    assert: value asInteger = 12.
    ## value dumpToConsole
}.

## testBlockClosureAdd2
{
    let value := evaluateSourceString("{:(Integer)x :(Integer)y :: Integer | x + y }").
    ##assert: value asInteger = 12.
    ##value dumpToConsole
}.

## testBlockClosureAdd3
{
    let value := evaluateSourceString("{:(Integer)x :(Integer)y :: Integer | x + y }(5. 7)").
    assert: value asInteger = 12.
    ##value dumpToConsole
}.


## testCompileConstantEvaluation
{
    let value := evaluateSourceString("{:: Boolean | 2 < 3 }").
    ##value dumpToConsole
    let evalResult := evaluateSourceString("{:: Boolean | 2 < 3 }()").
    assert: evalResult asBoolean
}.

## testCompileSequenceEvaluation
{
    let value := evaluateSourceString("{:: Integer | 1 . 2 }").
    ##value dumpToConsole
    let evalResult := evaluateSourceString("{:: Boolean | 1 . 2 }()").
    assert: evalResult asInteger = 2
}.

## testIfSelection
{
    ##let value := evaluateSourceString("{:(Boolean)cond :(Integer)x :(Integer)y :: Integer | if: cond then: x else: y }").
    ##value dumpToConsole.

    let trueValue := evaluateSourceString("{:(Boolean)cond :(Integer)x :(Integer)y :: Integer | if: cond then: x else: y }(true . 1. 2)").
    assert: trueValue asInteger = 1.
    
    let falseValue := evaluateSourceString("{:(Boolean)cond :(Integer)x :(Integer)y :: Integer | if: cond then: x else: y }(false . 1. 2)").
    assert: falseValue asInteger = 2.
}.

}