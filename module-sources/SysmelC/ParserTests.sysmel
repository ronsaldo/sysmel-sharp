## testParenthesis
{
    let parseTree := parseSourceString("(42)").
    assert: parseTree isLiteralIntegerNode.
    assert: parseTree value = 42.
}.

## testParenthesis2
{
    let parseTree := parseSourceString("()").
    assert: parseTree isTupleNode.
    assert: parseTree elements size = 0.
}.

## testQuasiQuote
{
    let parseTree := parseSourceString("``expr").
    assert: parseTree isQuasiQuoteNode.
    assert: parseTree expression isIdentifierReferenceNode.
    assert: parseTree expression value = #expr.
}.

## testQuasiUnquote
{
    let parseTree := parseSourceString("`,expr").
    assert: parseTree isQuasiUnquoteNode.
    assert: parseTree expression isIdentifierReferenceNode.
    assert: parseTree expression value = #expr.
}.

## testQuote
{
    let parseTree := parseSourceString("`'expr").
    assert: parseTree isQuoteNode.
    assert: parseTree expression isIdentifierReferenceNode.
    assert: parseTree expression value = #expr.
}.

## testSplice
{
    let parseTree := parseSourceString("`@expr").
    assert: parseTree isSpliceNode.
    assert: parseTree expression isIdentifierReferenceNode.
    assert: parseTree expression value = #expr.
}.

## testTuple
{
    let parseTree := parseSourceString("1, 2, 3").
    assert: parseTree isTupleNode.
    assert: parseTree elements size = 3.

    assert: (parseTree elements at: 0) isLiteralIntegerNode.
    assert: (parseTree elements at: 0) value = 1.

    assert: (parseTree elements at: 1) isLiteralIntegerNode.
    assert: (parseTree elements at: 1) value = 2.

    assert: (parseTree elements at: 2) isLiteralIntegerNode.
    assert: (parseTree elements at: 2) value = 3.
}.

## testUnaryMessageSend
{
    let parseTree := parseSourceString("42 negated").
    
    assert: parseTree isMessageSendNode.
    assert: parseTree receiver isLiteralIntegerNode.
    assert: parseTree receiver value = 42.

    assert: parseTree selector isLiteralSymbolNode.
    assert: parseTree selector value = #negated.

    assert: parseTree arguments size = 0.
}.

## testUnaryMethod
{
    let parseTree := parseSourceString("!{unary}").
    
    assert: parseTree isMethodNode.
    assert: parseTree selector = #unary.
}.

## testUnaryMethod2
{
    let parseTree := parseSourceString("!{unary self}").
    
    assert: parseTree isMethodNode.
    assert: parseTree selector = #unary.

    assert: parseTree body isIdentifierReferenceNode.
    assert: parseTree body value = #self
}.

} ## End of namespace SysmelC