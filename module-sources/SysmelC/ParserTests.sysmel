## testLiteralString
{
    let parseTree := parseSourceString("\"Hello World\"").
    assert: parseTree isLiteralStringNode.
    assert: parseTree value = "Hello World".
}.

## testLiteralSymbol
{
    let parseTree := parseSourceString("#test").
    assert: parseTree isLiteralSymbolNode.
    assert: parseTree value = #test.
}.

## testLiteralSymbol2
{
    let parseTree := parseSourceString("#test:with:").
    assert: parseTree isLiteralSymbolNode.
    assert: parseTree value = #test:with:.
}.

