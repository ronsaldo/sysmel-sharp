namespace SysmelC definition: {
let OrderedCollection := System Collections ArrayList(Value).
let TypeCacheDictionary := System Collections Dictionary(SysmelType . ListType).
public: [
class CompilationContext withSuperclass: Object fields: #{
    isInitialized: Boolean.
    pointerAlignment: Integer.
    pointerSize: Integer.

    currentEntitiesWithPendingAnalysis: OrderedCollection.

    listTypeCache: TypeCacheDictionary.

    globalNamespace: Namespace.
    
    BooleanType: NominalType.
    CharacterType: NominalType.
    FloatType: NominalType.
    IntegerType: NominalType.
    StringType: NominalType.
    SymbolType: NominalType.

    VoidType: NominalType.
    UndefinedObjectType: NominalType.
    DynamicType: NominalType.
    ParseTreeNodeType: NominalType.
    MacroContextType: NominalType.
    MetaBuilderType: NominalType.
    NamespaceType: NominalType.

    DynamicListType: ListType.
    ByteArrayType: ListType.

    Type0Type: TypeUniverse.
}.

].

let singleton := CompilationContext basicNew.
CompilationContext class !{
current :: CompilationContext.
    singleton ensureInitialization.
    singleton
}.

CompilationContext !{
ensureInitialization :: Void.
    if: isInitialized not then: {
        self initialize
    }
}.

CompilationContext !{
initialize :: Void.
    isInitialized := true.

    pointerAlignment := 8.
    pointerSize := 8.
    
    currentEntitiesWithPendingAnalysis := OrderedCollection new.
    listTypeCache := TypeCacheDictionary new.

    BooleanType := NominalType new
        name: #Boolean;
		valueSize: 1;
		valueAlignment: 1;
		valueIsPointer: false;
        yourself.

    CharacterType := NominalType new
        name: #Character;
		valueSize: 4;
		valueAlignment: 4;
		valueIsPointer: false;
        yourself.

    FloatType := NominalType new
        name: #Float;
		valueSize: 8;
		valueAlignment: 8;
		valueIsPointer: false;
        yourself.

    IntegerType := NominalType new
        name: #Integer;
		valueSize: 8;
		valueAlignment: 8;
		valueIsPointer: false;
        yourself.
    StringType := NominalType new
        name: #StringType;
		valueSize: 8;
		valueAlignment: 8;
		valueIsPointer: false;
        yourself.
    SymbolType := NominalType new
        name: #SymbolType;
		valueSize: 8;
		valueAlignment: 8;
		valueIsPointer: false;
        yourself.

    VoidType := NominalType new
        name: #Void;
		valueSize: 0;
		valueAlignment: 1;
		valueIsPointer: false;
        yourself.

    UndefinedObjectType := NominalType new
        name: #UndefinedObject;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.

    DynamicType := NominalType new
        name: #Dynamic;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.
    
    ParseTreeNodeType := NominalType new
        name: #ParseTreeNode;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.

    MacroContextType := NominalType new
        name: #MacroContext;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.

    MetaBuilderType := NominalType new
        name: #MetaBuilder;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.

    NamespaceType := NominalType new
        name: #Namespace;
		valueSize: pointerSize;
		valueAlignment: pointerAlignment;
		valueIsPointer: true;
        yourself.

    Type0Type := TypeUniverse new index: 0; yourself.

    DynamicListType := self getOrCreateListOfType: DynamicType.
    ##ByteArrayType: ListType.


    ##self registerGlobalsInSystemNamespace.
    ##self registerPrimitives.
}.

CompilationContext !{
globalNamespace :: Namespace.
    globalNamespace
}.

CompilationContext !{
BooleanType :: NominalType.
    BooleanType
}.

CompilationContext !{
CharacterType :: NominalType.
    CharacterType
}.

CompilationContext !{
FloatType :: NominalType.
    FloatType
}.

CompilationContext !{
IntegerType :: NominalType.
    IntegerType
}.

CompilationContext !{
StringType :: NominalType.
    StringType
}.

CompilationContext !{
SymbolType :: NominalType.
    SymbolType
}.

CompilationContext !{
VoidType :: NominalType.
    VoidType
}.

CompilationContext !{
UndefinedObjectType :: NominalType.
    UndefinedObjectType
}.

CompilationContext !{
DynamicType :: NominalType.
    DynamicType
}.

CompilationContext !{
ParseTreeNodeType :: NominalType.
    ParseTreeNodeType
}.

CompilationContext !{
MacroContextType :: NominalType.
    MacroContextType
}.

CompilationContext !{
MetaBuilderType :: NominalType.
    MetaBuilderType
}.

CompilationContext !{
NamespaceType :: NominalType.
    NamespaceType
}.

CompilationContext !{
DynamicListType :: ListType.
    DynamicListType
}.

CompilationContext !{
ByteArrayType :: ListType.
    ByteArrayType
}.

CompilationContext !{
Type0Type :: TypeUniverse.
    Type0Type
}.

CompilationContext !{
getOrCreateListOfType: (SysmelType)baseType :: ListType.
    if: (listTypeCache includesKey: baseType) then: {
        return: (listTypeCache at: baseType).
    }.
    
    let newListType := ListType new baseType: baseType; yourself.
    listTypeCache at: baseType put: newListType.
    newListType
}.

}.