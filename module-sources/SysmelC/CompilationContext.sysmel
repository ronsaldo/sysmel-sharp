namespace SysmelC definition: {
let OrderedCollection := System Collections ArrayList(Value).

let PointerTypeChacheDictionary := System Collections Dictionary(SysmelType . PointerType).
let ReferenceTypeChacheDictionary := System Collections Dictionary(SysmelType . ReferenceType).
let MutableBoxTypeCacheDictionary := System Collections Dictionary(SysmelType . MutableBoxType).
let ListTypeCacheDictionary := System Collections Dictionary(SysmelType . ListType).

public: [
class CompilationContext withSuperclass: Object fields: #{
    isInitialized: Boolean.
    pointerAlignment: Integer.
    pointerSize: Integer.

    currentEntitiesWithPendingAnalysis: OrderedCollection.

    pointerTypeChacheDictionary: PointerTypeChacheDictionary.
    referenceTypeChacheDictionary: ReferenceTypeChacheDictionary.
    mutableBoxTypeCache: MutableBoxTypeCacheDictionary.
    listTypeCache: ListTypeCacheDictionary.

    globalNamespace: Namespace.
    
    BooleanType: NominalType.
    CharacterType: NominalType.
    FloatType: NominalType.
    LargeIntegerType: IntegerType.
    StringType: NominalType.
    SymbolType: NominalType.

    VoidType: NominalType.
    UndefinedObjectType: NominalType.
    DynamicType: NominalType.
    ParseTreeNodeType: NominalType.
    MacroContextType: NominalType.
    MetaBuilderType: NominalType.
    NamespaceType: NominalType.
    
    Char8Type: IntegerType.
    Char16Type: IntegerType.
    Char32Type: IntegerType.

    UInt8Type: IntegerType.
    UInt16Type: IntegerType.
    UInt32Type: IntegerType.
    UInt64Type: IntegerType.

    Int8Type: IntegerType.
    Int16Type: IntegerType.
    Int32Type: IntegerType.
    Int64Type: IntegerType.
    
    DynamicListType: ListType.
    ByteArrayType: ListType.

    Type0Type: TypeUniverse.
}.

].

let singleton := CompilationContext basicNew.
CompilationContext class !{
current :: CompilationContext.
    singleton ensureInitialization.
    singleton
}.

CompilationContext !{
ensureInitialization :: Void.
    if: isInitialized not then: {
        self initialize
    }
}.

CompilationContext !{
initialize :: Void.
    isInitialized := true.

    pointerAlignment := 8.
    pointerSize := 8.
    
    currentEntitiesWithPendingAnalysis := OrderedCollection new.

    pointerTypeChacheDictionary := PointerTypeChacheDictionary new.
    referenceTypeChacheDictionary := ReferenceTypeChacheDictionary new.
    mutableBoxTypeCache := MutableBoxTypeCacheDictionary new.
    listTypeCache := ListTypeCacheDictionary new.

    BooleanType := NominalType new name: #Boolean; yourself.
    CharacterType := NominalType new name: #Character; yourself.
    FloatType := NominalType new name: #Float; yourself.
    LargeIntegerType := IntegerType new name: #Integer; valueSize: pointerSize; valueAlignment: pointerAlignment; isSigned: true; yourself.

    StringType := NominalType new name: #StringType; yourself.
    SymbolType := NominalType new name: #SymbolType; yourself.

    VoidType := NominalType new name: #Void; yourself.
    UndefinedObjectType := NominalType new name: #UndefinedObject; yourself.

    DynamicType := NominalType new name: #Dynamic; yourself.
    ParseTreeNodeType := NominalType new name: #ParseTreeNode; yourself.
    MacroContextType := NominalType new name: #MacroContext; yourself.
    MetaBuilderType := NominalType new name: #MetaBuilder; yourself.
    NamespaceType := NominalType new name: #Namespace; yourself.

    Type0Type := TypeUniverse new index: 0; yourself.

    Char8Type  := IntegerType new name: #Char8;  valueSize: 1; valueAlignment: 1; isSigned: false; yourself.
    Char16Type := IntegerType new name: #Char16; valueSize: 2; valueAlignment: 2; isSigned: false; yourself.
    Char32Type := IntegerType new name: #Char32; valueSize: 4; valueAlignment: 4; isSigned: false; yourself.

    UInt8Type  := IntegerType new name: #UInt8;  valueSize: 1; valueAlignment: 1; isSigned: false; yourself.
    UInt16Type := IntegerType new name: #UInt16; valueSize: 2; valueAlignment: 2; isSigned: false; yourself.
    UInt32Type := IntegerType new name: #UInt32; valueSize: 4; valueAlignment: 4; isSigned: false; yourself.
    UInt64Type := IntegerType new name: #UInt64; valueSize: 8; valueAlignment: 8; isSigned: false; yourself.

    Int8Type  := IntegerType new name: #Int8;  valueSize: 1; valueAlignment: 1; isSigned: true; yourself.
    Int16Type := IntegerType new name: #Int16; valueSize: 2; valueAlignment: 2; isSigned: true; yourself.
    Int32Type := IntegerType new name: #Int32; valueSize: 4; valueAlignment: 4; isSigned: true; yourself.
    Int64Type := IntegerType new name: #Int64; valueSize: 8; valueAlignment: 8; isSigned: true; yourself.

    DynamicListType := self getOrCreateListOfType: DynamicType.
    ByteArrayType := self getOrCreateListOfType: UInt8Type.

    self registerGlobalsInSystemNamespace.
    self registerPrimitives.
}.

CompilationContext !{
registerNominalType: (NominalType)aNominalType.
    globalNamespace setSymbol: aNominalType name binding: aNominalType.
}.

CompilationContext !{
registerGlobalsInSystemNamespace :: Void.
    globalNamespace := Namespace new name: #__global__; yourself.
    globalNamespace setSymbol: #Type binding: Type0Type.

    self registerNominalType: BooleanType.
    self registerNominalType: CharacterType.
    self registerNominalType: FloatType.
    self registerNominalType: LargeIntegerType.
    self registerNominalType: StringType.
    self registerNominalType: SymbolType.

    self registerNominalType: VoidType.
    self registerNominalType: UndefinedObjectType.
    self registerNominalType: DynamicType.
    self registerNominalType: ParseTreeNodeType.
    self registerNominalType: MacroContextType.
    self registerNominalType: MetaBuilderType.
    self registerNominalType: NamespaceType.
    
    self registerNominalType: Char8Type.
    self registerNominalType: Char16Type.
    self registerNominalType: Char32Type.

    self registerNominalType: UInt8Type.
    self registerNominalType: UInt16Type.
    self registerNominalType: UInt32Type.
    self registerNominalType: UInt64Type.

    self registerNominalType: Int8Type.
    self registerNominalType: Int16Type.
    self registerNominalType: Int32Type.
    self registerNominalType: Int64Type.

    globalNamespace setSymbol: #false binding: (BooleanValue new value: false; yourself).
    globalNamespace setSymbol: #true binding: (BooleanValue new value: true; yourself).
    globalNamespace setSymbol: #nil binding: UndefinedValue uniqueInstance.
    globalNamespace setSymbol: #void binding: VoidValue uniqueInstance.
}.

CompilationContext !{
registerControlFlowMacros :: Void.
    globalNamespace setSymbol: #if:then:else: binding: (
        ((MacroContextType -- ParseTreeNodeType -- ParseTreeNodeType -- ParseTreeNodeType) => ParseTreeNodeType)
            withSelector: #if:then:else: makePrimitiveMacroWithPrefix: "ControlFlow::" doing: {
                :(Value list)arguments :: Value |
                let context type: MacroContext := (arguments at: 0) asMacroContext.
                let condition type: ParseTreeNode := (arguments at: 1) asParseTreeNode.
                let trueExpression type: ParseTreeNode := (arguments at: 2) asParseTreeNode.
                let falseExpression type: ParseTreeNode := (arguments at: 3) asParseTreeNode..
                ParseTreeIfSelectionNode new
                    sourcePosition: context sourcePosition;
                    condition: condition;
                    trueExpression: trueExpression;
                    falseExpression: falseExpression;
                    yourself
            }
    ).
    globalNamespace setSymbol: #if:then: binding: (
        ((MacroContextType -- ParseTreeNodeType -- ParseTreeNodeType) => ParseTreeNodeType)
            withSelector: #if:then: makePrimitiveMacroWithPrefix: "ControlFlow::" doing: {
                :(Value list)arguments :: Value |
                let context type: MacroContext := (arguments at: 0) asMacroContext.
                let condition type: ParseTreeNode := (arguments at: 1) asParseTreeNode.
                let trueExpression type: ParseTreeNode := (arguments at: 2) asParseTreeNode.
                ParseTreeIfSelectionNode new
                    sourcePosition: context sourcePosition;
                    condition: condition;
                    trueExpression: trueExpression;
                    yourself
            }
    ).
}.

CompilationContext !{
registerDefinitionMacros :: Void.
    globalNamespace setSymbol: #let:with: binding: (
        ((MacroContextType -- ParseTreeNodeType -- ParseTreeNodeType) => ParseTreeNodeType)
            withSelector: #let:with: makePrimitiveMacroWithPrefix: "Definition::" doing: {
                :(Value list)arguments :: Value |
                let context type: MacroContext := (arguments at: 0) asMacroContext.
                let nameExpression type: ParseTreeNode := (arguments at: 1) asParseTreeNode.
                let initialValueExpression type: ParseTreeNode := (arguments at: 2) asParseTreeNode.
                ParseTreeVariableDefinitionNode new
                    sourcePosition: context sourcePosition;
                    nameExpression: nameExpression;
                    optionalInitialValue: initialValueExpression;
                    isMutable: false;
                    yourself
            }
    ).
    globalNamespace setSymbol: #let:mutableWith: binding: (
        ((MacroContextType -- ParseTreeNodeType -- ParseTreeNodeType) => ParseTreeNodeType)
            withSelector: #let:mutableWith: makePrimitiveMacroWithPrefix: "Definition::" doing: {
                :(Value list)arguments :: Value |
                let context type: MacroContext := (arguments at: 0) asMacroContext.
                let nameExpression type: ParseTreeNode := (arguments at: 1) asParseTreeNode.
                let initialValueExpression type: ParseTreeNode := (arguments at: 2) asParseTreeNode.
                ParseTreeVariableDefinitionNode new
                    sourcePosition: context sourcePosition;
                    nameExpression: nameExpression;
                    optionalInitialValue: initialValueExpression;
                    isMutable: true;
                    yourself
            }
    ).
}.

CompilationContext !{
registerIntegerPrimitives: (NominalType)integerType :: Void.
    let unaryOperationType := integerType => integerType.
    let binaryOperationType := (integerType -- integerType) => integerType.
    let comparisonOperationType := (integerType -- integerType) => BooleanType.
    let namePrefix := integerType name asString -- "::".

    integerType addMethod: (unaryOperationType withSelector: #negated makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let numberValue := (arguments at: 0) asInteger.
        IntegerValue new value: numberValue negated; type: integerType; yourself
    }).
    integerType addMethod: (unaryOperationType withSelector: #bitInvert makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let numberValue := (arguments at: 0) asInteger.
        IntegerValue new value: numberValue bitInvert; type: integerType; yourself
    }).

    ## Arithmetic.
    integerType addMethod: (binaryOperationType withSelector: #+ makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := (arguments at: 0) asInteger.
        let rightOperand := (arguments at: 1) asInteger.
        IntegerValue new value: leftOperand + rightOperand; type: integerType; yourself
    }).
    integerType addMethod: (binaryOperationType withSelector: #- makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := (arguments at: 0) asInteger.
        let rightOperand := (arguments at: 1) asInteger.
        IntegerValue new value: leftOperand - rightOperand; type: integerType; yourself
    }).
    integerType addMethod: (binaryOperationType withSelector: #"*" makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := (arguments at: 0) asInteger.
        let rightOperand := (arguments at: 1) asInteger.
        IntegerValue new value: leftOperand * rightOperand; type: integerType; yourself
    }).
    integerType addMethod: (binaryOperationType withSelector: #// makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := (arguments at: 0) asInteger.
        let rightOperand := (arguments at: 1) asInteger.
        IntegerValue new value: leftOperand // rightOperand; type: integerType; yourself
    }).
    integerType addMethod: (binaryOperationType withSelector: #% makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := (arguments at: 0) asInteger.
        let rightOperand := (arguments at: 1) asInteger.
        IntegerValue new value: leftOperand % rightOperand; type: integerType; yourself
    }).
    
    integerType addMethod: (comparisonOperationType withSelector: #= makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.
        if: (nil == leftOperand) || (nil == rightOperand) then: {
            return: (BooleanValue with: leftOperand == rightOperand)
        }.

        BooleanValue with: leftOperand asInteger = rightOperand asInteger
    }).
    integerType addMethod: (comparisonOperationType withSelector: #~= makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.
        if: (nil == leftOperand) || (nil == rightOperand) then: {
            return: (BooleanValue with: leftOperand ~~ rightOperand)
        }.

        BooleanValue with: leftOperand asInteger ~= rightOperand asInteger
    }).
    integerType addMethod: (comparisonOperationType withSelector: #< makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.

        BooleanValue with: leftOperand asInteger < rightOperand asInteger
    }).
    integerType addMethod: (comparisonOperationType withSelector: #<= makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.

        BooleanValue with: leftOperand asInteger <= rightOperand asInteger
    }).
    integerType addMethod: (comparisonOperationType withSelector: #> makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.

        BooleanValue with: leftOperand asInteger > rightOperand asInteger
    }).
    integerType addMethod: (comparisonOperationType withSelector: #>= makeCompileTimePrimitiveWithPrefix: namePrefix doing: {
        :(Value list)arguments :: Value |
        let leftOperand := arguments at: 0.
        let rightOperand := arguments at: 1.

        BooleanValue with: leftOperand asInteger >= rightOperand asInteger
    }).
}.

CompilationContext !{
registerPrimitives :: Void.
    self registerControlFlowMacros.
    self registerDefinitionMacros.
    
    self registerIntegerPrimitives: CharacterType.
    self registerIntegerPrimitives: LargeIntegerType.
    
    self registerIntegerPrimitives: Char8Type.
    self registerIntegerPrimitives: Char16Type.
    self registerIntegerPrimitives: Char32Type.

    self registerIntegerPrimitives: UInt8Type.
    self registerIntegerPrimitives: UInt16Type.
    self registerIntegerPrimitives: UInt32Type.
    self registerIntegerPrimitives: UInt64Type.
    
    self registerIntegerPrimitives: Int8Type.
    self registerIntegerPrimitives: Int16Type.
    self registerIntegerPrimitives: Int32Type.
    self registerIntegerPrimitives: Int64Type.
}.

CompilationContext !{
globalNamespace :: Namespace.
    globalNamespace
}.

CompilationContext !{
BooleanType :: NominalType.
    BooleanType
}.

CompilationContext !{
CharacterType :: NominalType.
    CharacterType
}.

CompilationContext !{
FloatType :: NominalType.
    FloatType
}.

CompilationContext !{
LargeIntegerType :: IntegerType.
    LargeIntegerType
}.

CompilationContext !{
StringType :: NominalType.
    StringType
}.

CompilationContext !{
SymbolType :: NominalType.
    SymbolType
}.

CompilationContext !{
VoidType :: NominalType.
    VoidType
}.

CompilationContext !{
UndefinedObjectType :: NominalType.
    UndefinedObjectType
}.

CompilationContext !{
DynamicType :: NominalType.
    DynamicType
}.

CompilationContext !{
ParseTreeNodeType :: NominalType.
    ParseTreeNodeType
}.

CompilationContext !{
MacroContextType :: NominalType.
    MacroContextType
}.

CompilationContext !{
MetaBuilderType :: NominalType.
    MetaBuilderType
}.

CompilationContext !{
NamespaceType :: NominalType.
    NamespaceType
}.

CompilationContext !{
DynamicListType :: ListType.
    DynamicListType
}.

CompilationContext !{
ByteArrayType :: ListType.
    ByteArrayType
}.

CompilationContext !{
Type0Type :: TypeUniverse.
    Type0Type
}.

CompilationContext !{
Char8Type :: IntegerType.
    Char8Type
}.

CompilationContext !{
Char16Type :: IntegerType.
    Char16Type
}.

CompilationContext !{
Char32Type :: IntegerType.
    Char32Type
}.

CompilationContext !{
UInt8Type :: IntegerType.
    UInt8Type
}.

CompilationContext !{
UInt16Type :: IntegerType.
    UInt16Type
}.

CompilationContext !{
UInt32Type :: IntegerType.
    UInt32Type
}.

CompilationContext !{
UInt64Type :: IntegerType.
    UInt64Type
}.

CompilationContext !{
Int8Type :: IntegerType.
    Int8Type
}.

CompilationContext !{
Int16Type :: IntegerType.
    Int16Type
}.

CompilationContext !{
Int32Type :: IntegerType.
    Int32Type
}.

CompilationContext !{
Int64Type :: IntegerType.
    Int64Type
}.

CompilationContext !{
getOrCreatePointerType: (SysmelType)baseType :: PointerType.
    if: (pointerTypeChacheDictionary includesKey: baseType) then: {
        return: (pointerTypeChacheDictionary at: baseType).
    }.
    
    let pointerType := PointerType new baseType: baseType; yourself.
    pointerTypeChacheDictionary at: baseType put: pointerType.
    pointerType
}.

CompilationContext !{
getOrCreateReferenceType: (SysmelType)baseType :: ReferenceType.
    if: (referenceTypeChacheDictionary includesKey: baseType) then: {
        return: (referenceTypeChacheDictionary at: baseType).
    }.
    
    let refType := ReferenceType new baseType: baseType; yourself.
    referenceTypeChacheDictionary at: baseType put: refType.
    refType
}.


CompilationContext !{
getOrCreateMutableBoxOfType: (SysmelType)baseType :: MutableBoxType.
    if: (mutableBoxTypeCache includesKey: baseType) then: {
        return: (mutableBoxTypeCache at: baseType).
    }.
    
    let boxType := MutableBoxType new baseType: baseType; yourself.
    mutableBoxTypeCache at: baseType put: boxType.
    boxType
}.

CompilationContext !{
getOrCreateListOfType: (SysmelType)baseType :: ListType.
    if: (listTypeCache includesKey: baseType) then: {
        return: (listTypeCache at: baseType).
    }.
    
    let newListType := ListType new baseType: baseType; yourself.
    listTypeCache at: baseType put: newListType.
    newListType
}.

}.