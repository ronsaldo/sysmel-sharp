## SplitReceiverForCascade
## 
ParseTreeNode !{
splitReceiverForCascade :: ParseTreeNode list.
    (ParseTreeNode list new: 2)
        at: 0 put: self;
        at: 1 put: nil;
        yourself
}.

ParseTreeMessageSendNode !{
splitReceiverForCascade :: ParseTreeNode list.
    (ParseTreeNode list new: 2)
        at: 0 put: receiver;
        at: 1 put: (ParseTreeCascadedMessageNode new
            sourcePosition: sourcePosition;
            selector: selector;
            arguments: arguments;
            yourself);
        yourself
}.


