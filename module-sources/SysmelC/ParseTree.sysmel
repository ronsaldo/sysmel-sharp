## ParseTreeFunctionalDependentTypeNode
public: [
class ParseTreeFunctionalDependentTypeNode withSuperclass: ParseTreeNode fields: #{
    argumentDefinitions: ParseTreeNode list.
    resultTypeExpression: ParseTreeNode.
    selector: Symbol
}
].

ParseTreeNode !{
isFunctionalDependentType :: Boolean.
    false.
}.

ParseTreeFunctionalDependentTypeNode !{
isFunctionalDependentType :: Boolean.
    true.
}.

ParseTreeFunctionalDependentTypeNode !{
argumentDefinitions :: ParseTreeNode list.
    argumentDefinitions
}.

ParseTreeFunctionalDependentTypeNode !{
argumentDefinitions: (ParseTreeNode list)newArguments :: Void.
    argumentDefinitions := newArguments
}.

ParseTreeFunctionalDependentTypeNode !{
resultTypeExpression :: ParseTreeNode.
    resultTypeExpression
}.

ParseTreeFunctionalDependentTypeNode !{
resultTypeExpression: (ParseTreeNode)newResultTypeExpression :: Void.
    resultTypeExpression := newResultTypeExpression
}.

ParseTreeFunctionalDependentTypeNode !{
selector :: Symbol.
    selector
}.

ParseTreeFunctionalDependentTypeNode !{
selector: (Symbol)newSelector :: Void.
    selector := newSelector
}.

ParseTreeFunctionalDependentTypeNode !{
addSelfWithType: (ParseTreeNode)aTypeExpression :: Void.
    let selfArgument := ParseTreeArgumentDefinitionNode new
		sourcePosition: sourcePosition;
		name: #self;
		typeExpression: aTypeExpression;
		yourself.

    argumentDefinitions := ((ParseTreeNode list new: 1)
                                at: 0 put: selfArgument;
                                yourself) -- argumentDefinitions
}.

