namespace SysmelC definition: {

let SymbolHashtable := System Collections Dictionary(Symbol. Value).

public: [

class Environment withSuperclass: Value fields: #{
}.

class EmptyEnvironment withSuperclass: Environment fields: #{
}.

class LexicalEnvironment withSuperclass: Environment fields: #{
    parent: Environment.
    localSymbols: SymbolHashtable.
}.

class NamespaceEnvironment withSuperclass: Environment fields: #{
    parent: Environment.
    namespaceValue: Namespace
}.

].

## Environment
Environment !{
lookupRecursively: (Symbol)aSymbol :: Value.
    error: "Subclass responsibility"
}.

Environment !{
lookupNamespace :: Namespace.
    printLine(self).
    error: "Subclass responsibility"
}.

## EmptyEnvironment
EmptyEnvironment !{
lookupRecursively: (Symbol)aSymbol :: Value.
    nil
}.

EmptyEnvironment !{
lookupNamespace :: Namespace.
    nil
}.

## Lexical environment
LexicalEnvironment class !{
withParent: (Environment)aParent :: LexicalEnvironment.
    LexicalEnvironment new parent: aParent; yourself
}.

LexicalEnvironment !{
initialize :: Void.
    localSymbols := SymbolHashtable new.
}.

LexicalEnvironment !{
setSymbol: (Symbol)symbol binding: (Value)binding :: Void.
    localSymbols at: symbol put: binding
}.

LexicalEnvironment !{
lookupRecursively: (Symbol)aSymbol :: Value.
    let localSymbol := localSymbols atOrNil: aSymbol.
    if: nil ~~ localSymbol then: {
        return: localSymbol
    }.

    parent lookupRecursively: aSymbol
}.

LexicalEnvironment !{
parent: (Environment)newParent :: Void.
    parent := newParent
}.

LexicalEnvironment !{
lookupNamespace :: Namespace.
    parent lookupNamespace
}.

## Namespace environment
NamespaceEnvironment class !{
withParent: (Environment)aParent namespace: (Namespace)aNamespace :: NamespaceEnvironment.
    NamespaceEnvironment new parent: aParent; namespace: aNamespace; yourself
}.

NamespaceEnvironment !{
parent: (Environment)newParent :: Void.
    parent := newParent
}.

NamespaceEnvironment !{
namespace: (Namespace)aNamespace :: Void.
    namespaceValue := aNamespace
}.

NamespaceEnvironment !{
lookupRecursively: (Symbol)aSymbol :: Value.
    let namespaceSymbol := namespaceValue lookSymbol: aSymbol.
    if: nil ~~ namespaceSymbol then: {
        return: namespaceSymbol
    }.

    parent lookupRecursively: aSymbol
}.

NamespaceEnvironment !{
lookupNamespace :: Namespace.
    namespaceValue
}.


}.