namespace SysmelC definition: {
Value !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    self
}.

Value !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment withExpectedType: (SysmelType)anExpectedType :: Value.
    let evaluationResult := self analyzeAndEvaluateInEnvironment: environment.
    self castAnalyzedAndEvaluatedValue: evaluationResult toExpectedType: anExpectedType
}.

Value !{
castAnalyzedAndEvaluatedValue: (Value)valueToCast toExpectedType: (SysmelType)anExpectedType :: Value.
    #*if: (nil = anExpectedType) || (anExpectedType isSatisfiedByValue: valueToCast) then: {
        return: valueToCast
    }.

    if: valueToCast type isReferenceLikeType then: {
        error: "ToDo: loadRef".
        return: (self castAnalyzedAndEvaluatedValue: valueToCast loadValue toExpectedType: anExpectedType).
    }.

    if: anExpectedType = CompilationContext current DynamicType then: {
        if: valueToCast type = CompilationContext current DynamicType then: {
            return: valueToCast
        }.

        return: (DynamicValue new
            sourcePosition: valueToCast sourcePosition;
            value: valueToCast;
            yourself).
    }.

    if: valueToCast type = CompilationContext current DynamicType then: {
        return: (self castAnalyzedAndEvaluatedValue: valueToCast unboxFromDynamicValue toExpectedType: anExpectedType)
    }.

    ## TODO: implement this part.
    Stdio stderr printLine: valueToCast.
    Stdio stderr printLine: anExpectedType.
    error: "Failed to perform cast."
    *#
    valueToCast
}.

Value !{
analyzeAndEvaluateInEnvironmentWithDecayedType: (LexicalEnvironment)anEnvironment :: Value.
    let evaluationResult := self analyzeAndEvaluateInEnvironment: anEnvironment.
    if: evaluationResult type isReferenceType then: {
        error: "ToDo: decay reference"
    }.

    evaluationResult
}.

ParseTreeNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    printLine(self).
    error: "Subclass responsibility".
}.

ParseTreeErrorNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    printLine(sourcePosition).
    error: errorMessage.
}.

Value !{
analyzeAndEvaluateApplication: (ParseTreeApplicationNode)applicationNode inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    error: "Not a functional value"
}.

FunctionalValue !{
analyzeAndEvaluateApplication: (ParseTreeApplicationNode)applicationNode inEnvironment: (LexicalEnvironment)environment :: Value.
    if: isMacro then: {
        let macroContext := MacroContext new
            sourcePosition: applicationNode sourcePosition;
            environment: environment;
            yourself.

        let argumentCount := applicationNode arguments size.
        let macroArguments := Value list new: 1 + argumentCount.
        macroArguments at: 0 put: macroContext.
        let i mutable := 0.
        while: i < argumentCount  do: {
            macroArguments at: i + 1 put: (applicationNode arguments at: i)
        } continueWith: (i :=  i + 1).

        let macroResult := self evaluateWithArguments: macroArguments.
        return: (macroResult analyzeAndEvaluateInEnvironment: environment)
    }.

    #*
    let functionType := type.
    let argumentValues := applicationNode arguments collectWithIndex: {:each :(Integer)index |
        let eachArgumentValue type: Value := each.
        let argumentDefinition type: ArgumentValue := functionType argumentDefinitions at: index.
        let argumentType := argumentDefinition type.
        eachArgumentValue analyzeAndEvaluateInEnvironment: environment withExpectedType: argumentType
    }.

    self evaluateWithArguments: argumentValues*#
    error: "Todo: FunctionalValue >> #analyzeAndEvaluateApplication"

}.

ParseTreeApplicationNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let functionalValue type: Value := functional analyzeAndEvaluateInEnvironmentWithDecayedType: environment.

    functionalValue analyzeAndEvaluateApplication: self inEnvironment: environment
}.

## Binary expression sequence
ParseTreeBinaryExpressionSequenceNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    self expandAsMessageSendSequence analyzeAndEvaluateInEnvironment: environment
}.

ParseTreeBinaryExpressionSequenceNode !{
expandAsMessageSendSequence :: ParseTreeNode.
    let result mutable := operands at: 0.
    let operandCount := operands size.
    let index mutable := 1.
    while: (index < operandCount) do: {
        let operator := operands at: index.
        let operand := operands at: index + 1.

        let messageSend := ParseTreeMessageSendNode new
            sourcePosition: operator sourcePosition;
            receiver: result;
            selector: operator;
            arguments: ((ParseTreeNode list new: 1)
                at: 0 put: operand;
                yourself);
            yourself.

        result := messageSend
    } continueWith: (index := index + 2).

    result
}.

## Identifiers
Value !{
analyzeAndEvaluateIdentifierReference: (ParseTreeIdentifierReferenceNode)identifierReference inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    self
}.

ParseTreeIdentifierReferenceNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let lookupValue := environment lookupRecursively: value.
    if: nil == lookupValue then: {
        error: "Failed to find identifier for " -- value printString
    }.

    lookupValue analyzeAndEvaluateIdentifierReference: self inEnvironment: environment
}.

## If selection.
ParseTreeIfSelectionNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let conditionValue := condition analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current BooleanType.
    let conditionBooleanValue := conditionValue asBoolean.
    if: conditionBooleanValue then: {
        if: nil ~~ trueExpression then: {
            return: (trueExpression analyzeAndEvaluateInEnvironment: environment)
        }
    } else: {
        if: nil ~~ falseExpression then: {
            return: (falseExpression analyzeAndEvaluateInEnvironment: environment)
        }
    }.

    VoidValue uniqueInstance
}.

## Lexical block
ParseTreeLexicalBlockNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let childEnvironment := LexicalEnvironment withParent: environment.
    body analyzeAndEvaluateInEnvironment: childEnvironment
}.

## Literals
ParseTreeLiteralBooleanNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    BooleanValue new value: value; yourself
}.

ParseTreeLiteralCharacterNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    IntegerValue new value: value asInteger; type: CompilationContext current CharacterType; yourself
}.

ParseTreeLiteralFloatNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    FloatValue new value: value; type: CompilationContext current FloatType; yourself
}.

ParseTreeLiteralIntegerNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    IntegerValue new value: value; type: CompilationContext current LargeIntegerType; yourself
}.

ParseTreeLiteralStringNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    StringValue new value: value; type: CompilationContext current StringType; yourself
}.

ParseTreeLiteralSymbolNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    SymbolValue new value: value; type: CompilationContext current SymbolType; yourself
}.

## ParseTreeListNode
ParseTreeListNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let elementCount := elements size.
    let elementValues := Value list new: elementCount.
    let i mutable := 0.
    while: (i < elementCount) do: {
        let elementValue := (elements at: i) analyzeAndEvaluateInEnvironmentWithDecayedType: environment.
        elementValues at: i put: elementValue
    } continueWith: (i := i + 1).

    ListValue new
        sourcePosition: sourcePosition;
        elements: elementValues;
        type: CompilationContext current DynamicListType;
        yourself
}.

ParseTreeSequenceNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let result mutable type: Value := VoidValue uniqueInstance.
    let elementsCount := elements size. 
    let i mutable := 0.
    while: (i < elementsCount) do: {
        result := (elements at: i) analyzeAndEvaluateInEnvironment: environment
    } continueWith: (i := i + 1).

    result
}.

## ParseTreeVariableDefinitionNode
ParseTreeVariableDefinitionNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let name := nameExpression analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current SymbolType.
    let typeValue mutable type: SysmelType := nil.
    if: nil ~~ optionalTypeExpression then: {
        let typeExpressionValue := optionalTypeExpression analyzeAndEvaluateInEnvironment: environment.
        typeValue := typeExpressionValue asType
    }.
    
    let initialValue mutable type: Value := nil.
    if: nil ~~ optionalInitialValue then: {
        initialValue := optionalInitialValue analyzeAndEvaluateInEnvironment: environment withExpectedType: typeValue.
    }.

    if: isMutable then: {
        let valueType := initialValue type.
        let boxType := CompilationContext current getOrCreateMutableBoxOfType: valueType.
        let boxValue := MutableValueBox new
            currentValue: initialValue;
            type: boxType;
            yourself.
        let referenceType := CompilationContext current getOrCreateReferenceType: valueType.
        let referenceValue := ReferenceValue new
            storage: boxValue;
            fieldIndex: 0;
            type: referenceType;
            yourself.
        environment setSymbol: name asSymbolValue binding: referenceValue.
        return: referenceValue
    }.

    environment setSymbol: name asSymbolValue binding: initialValue.
    initialValue
}.

Value !{
analyzeAndEvaluateAssignment: (ParseTreeAssignmentNode)assignment inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    let storageValue := self.
    if: storageValue type isReferenceType then: {
        let valueToStore := assignment value analyzeAndEvaluateInEnvironment: anEnvironment withExpectedType: storageValue type baseType.
        storageValue storeValue: valueToStore.
        return: storageValue
    }.

    error: "Not assignable value"
}.

ParseTreeAssignmentNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let storageValue := storage analyzeAndEvaluateInEnvironment: environment.
    storageValue analyzeAndEvaluateAssignment: self inEnvironment: environment
}.

Value !{
sysmelPerform: (Symbol)selector withArguments: (Value list)arguments :: Value.
    let foundMethod := self lookupSelector: selector.
    if: nil == foundMethod then: {
        error: "Message not understood: " -- selector printString
    }.

    let evaluationArguments := Value list new: 1 + arguments size.
    evaluationArguments at: 0 put: self.

    let i mutable := 0.
    while: (i < arguments size) do: {
        evaluationArguments at: i + 1 put: (arguments at: i)
    } continueWith: (i := i + 1).

    foundMethod evaluateWithArguments: evaluationArguments
}.

ReferenceValue !{
sysmelPerform: (Symbol)selector withArguments: (Value list)arguments :: Value.
    self loadValue sysmelPerform: selector withArguments: arguments
}.

EnumType !{
sysmelPerform: (Symbol)selector withArguments: (Value list)arguments :: Value.
    if: (arguments size = 0) && (namesAndValues includesKey: selector) then: {
        let value := namesAndValues at: selector.
        return: value
    }.

    super sysmelPerform: selector withArguments: arguments
}.

Value !{
analyzeAndEvaluateMessageSend: (ParseTreeMessageSendNode)messageSend selector: (Value)selectorValue inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    let selectorSymbol := selectorValue asSymbolValue.
    let foundMethod := self lookupSelector: selectorSymbol.
    if: (nil ~~ foundMethod) && (foundMethod isMacro) then: {
        error: "ToDo: perform macro expansion."
    }.

    let argumentCount := messageSend arguments size.
    let argumentValues := Value list new: argumentCount.
    let i mutable := 0.
    while: i < argumentCount do: {
        let eachArg := messageSend arguments at: i.
        argumentValues at: i put: (eachArg analyzeAndEvaluateInEnvironment: anEnvironment)
    } continueWith: (i := i + 1).

    self sysmelPerform: selectorSymbol withArguments: argumentValues
}.

ParseTreeMessageSendNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let receiverValue := receiver analyzeAndEvaluateInEnvironment: environment.
    let selectorValue := selector analyzeAndEvaluateInEnvironment: environment.
    receiverValue analyzeAndEvaluateMessageSend: self selector: selectorValue inEnvironment: environment
}.

## Do while loop.
ParseTreeDoWhileLoopNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    do: {
        if: nil ~~ bodyExpression then: {
            bodyExpression analyzeAndEvaluateInEnvironment: environment
        }.

        if: nil ~~ optionalContinueExpression then: {
            optionalContinueExpression analyzeAndEvaluateInEnvironment: environment
        }.        
    } while: (condition analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current BooleanType) asBoolean.

    VoidValue uniqueInstance
}.

## While loop.
ParseTreeWhileLoopNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    while: (condition analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current BooleanType) asBoolean do: {
        if: nil ~~ bodyExpression then: {
            bodyExpression analyzeAndEvaluateInEnvironment: environment
        }.

        if: nil ~~ optionalContinueExpression then: {
            optionalContinueExpression analyzeAndEvaluateInEnvironment: environment
        }.
    }.

    VoidValue uniqueInstance
}.

## Namespace
ParseTreeNamespaceNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let name := nameExpression analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current SymbolType.
    let ownerNamespace := environment lookupNamespace.
    let childNamespace := ownerNamespace getOrCreateNamespaceWithName: name asSymbolValue.

    let childNamespaceEnvironment := NamespaceEnvironment withParent: environment namespace: childNamespace.
    let childLexicalEnvironment := LexicalEnvironment withParent: childNamespaceEnvironment.

    if: nil ~~ definitionBody then: {
        definitionBody analyzeAndEvaluateInEnvironment: childLexicalEnvironment
    }.

    childNamespace
}.

## Namespace
ParseTreeRecordDefinitionNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let nameSymbol mutable type: Symbol := nil.
    if: nil ~~ nameExpression then:
    {
        let name := nameExpression analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current SymbolType.
        nameSymbol := name asSymbolValue
    }.

    let recordType := RecordType new name: nameSymbol; yourself.
    if: nil ~~ nameSymbol then: {
        environment setSymbol: nameSymbol binding: recordType.
    }.

    let fieldsValue := fields analyzeAndEvaluateInEnvironment: environment.
    if: fieldsValue isImmutableDictionaryValue not then: {
        error: "Expected a dictionary with the record fields"
    }.

    let fieldsDictionary := fieldsValue asImmutableDictionaryValue.
    let fieldCount := fieldsDictionary elements size.
    let fields := (FieldDefinition list new: fieldCount) yourself.
    let i mutable := 0.
    while: i < fieldCount do: {
        let eachAssociation := fieldsDictionary elements at: i.
        let fieldName := eachAssociation key asSymbolValue.
        let fieldType := eachAssociation value asType.

        let field := FieldDefinition new
            name: fieldName;
            index: i;
            type: fieldType;
            yourself.
        
        fields at: i put: field
    } continueWith: (i := i + 1).

    recordType
        fields: fields;
        buildFieldsByNameTable;
        yourself
}.


## Association node
ParseTreeAssociationNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let keyValue := key analyzeAndEvaluateInEnvironmentWithDecayedType: environment.
    let valueValue mutable type: Value := UndefinedValue uniqueInstance.
    if: nil ~~ value then: {
        valueValue := value analyzeAndEvaluateInEnvironmentWithDecayedType: environment.
    }.

    if: keyValue isType && valueValue isType then: {
        return: (AssociationType withKey: keyValue asType andValue: valueValue asType)
    }.

    let keyType := keyValue type.
    let valueType := valueValue type.
    let associationType := AssociationType withKey: keyType andValue: valueType.
    AssociationValue new
        sourcePosition: sourcePosition;
        key: keyValue;
        value: valueValue;
        type: associationType;
        yourself
}.

## Immutable dictionary.
Value !{
analyzeAndEvaluateDictionaryInstance: (ParseTreeImmutableDictionaryNode)dictionary inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    error: "No dictionary type expression."
}.

RecordType !{
analyzeAndEvaluateDictionaryInstance: (ParseTreeImmutableDictionaryNode)dictionary inEnvironment: (LexicalEnvironment)anEnvironment :: Value.
    let fieldCount := fields size.
    let fieldValues := Value list new: fieldCount.
    let initializedFields := Boolean list new: fieldCount.
    {
        let i mutable := 0.
        while: (i < fieldCount) do: {
            initializedFields at: i put: false
        } continueWith:(i := i + 1)
    }.

    {
        let dictionaryElementCount := dictionary elements size.
        let i mutable := 0.
        while: (i < dictionaryElementCount) do: {
            let associationParseTreeNode := (dictionary elements at: i) asParseTreeAssociationNode.
            let fieldNameValue := associationParseTreeNode key analyzeAndEvaluateInEnvironment: anEnvironment withExpectedType: CompilationContext current SymbolType.
            let fieldNameSymbol := fieldNameValue asSymbolValue.

            let fieldDefinitionOrNil := fieldsByName atOrNil: fieldNameSymbol.
            if: nil == fieldDefinitionOrNil then: {
                error: "Record does not have a field named " -- fieldNameSymbol printString
            }.


            let fieldValue := associationParseTreeNode value analyzeAndEvaluateInEnvironment: anEnvironment withExpectedType: fieldDefinitionOrNil type.
            fieldValues at: fieldDefinitionOrNil index put: fieldValue.
            initializedFields at: fieldDefinitionOrNil index put: true.
        } continueWith: (i := i + 1).
    }.

    {
        let i mutable := 0.
        while: (i < fieldCount) do: {
            let isInitialized type: Boolean := initializedFields at: i.
            if: isInitialized not then: {
                let field := fields at: i.
                let fieldType := field type.
                fieldValues at: i put: fieldType defaultValue
            }

        } continueWith: (i := i + 1).        
    }.

    RecordValue new
        elements: fieldValues;
        type: self;
        yourself
}.

ParseTreeImmutableDictionaryNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    if: nil ~~ dictionaryType then: {
        let dictionaryTypeValue := dictionaryType analyzeAndEvaluateInEnvironment: environment.
        return: (dictionaryTypeValue analyzeAndEvaluateDictionaryInstance: self inEnvironment: environment)
    }.

    let elementCount := elements size.
    let elementValues := AssociationValue list new: elementCount.
    let i mutable := 0.
    while: i < elementCount do: {
        let element := elements at: i.
        let analyzedElement := element analyzeAndEvaluateInEnvironmentWithDecayedType: environment.
        elementValues at: i put: analyzedElement asAssociationValue
    } continueWith: (i := i + 1).

    let dynamicType := CompilationContext current DynamicType.
    let associationType := AssociationType withKey: dynamicType andValue: dynamicType.
    let dictionaryType := ImmutableDictionaryType withAssociationType: associationType.

    ImmutableDictionaryValue new
        elements: elementValues;
        type: dictionaryType;
        yourself
}.

## Enum
Value !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)anEnvironment withEnumBaseType: (SysmelType)enumBaseType :: Value.
    error: "Expected a dictionary or association instead of " -- self printString
}.

ParseTreeAssociationNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment withEnumBaseType: (SysmelType)enumBaseType :: Value.
    let keyValue := key analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current SymbolType.
    let valueValue mutable type: Value := UndefinedValue uniqueInstance.
    if: nil ~~ value then: {
        valueValue := value analyzeAndEvaluateInEnvironment: environment withExpectedType: enumBaseType.
    }.

    let associationType := AssociationType withKey: CompilationContext current SymbolType andValue: enumBaseType.
    AssociationValue new
        sourcePosition: sourcePosition;
        key: keyValue;
        value: valueValue;
        type: associationType;
        yourself.
}.

ParseTreeImmutableDictionaryNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment withEnumBaseType: (SysmelType)enumBaseType :: Value.
    if: nil ~~ dictionaryType then: {
        error: "TODO: dictionary make instance".
        #*
        let dictionaryTypeValue := dictionaryType analyzeAndEvaluateInEnvironment: environment.
        return: (dictionaryTypeValue analyzeAndEvaluateDictionaryInstance: self inEnvironment: environment)
        *#
    }.

    let elementCount := elements size.
    let elementValues := AssociationValue list new: elementCount.
    let i mutable := 0.
    while: i < elementCount do: {
        let element := elements at: i.
        let analyzedElement := element analyzeAndEvaluateInEnvironment: environment withEnumBaseType: enumBaseType.
        elementValues at: i put: analyzedElement asAssociationValue
    } continueWith: (i := i + 1).

    let associationType := AssociationType withKey: CompilationContext current SymbolType andValue: enumBaseType.
    let dictionaryType := ImmutableDictionaryType withAssociationType: associationType.

    ImmutableDictionaryValue new
        elements: elementValues;
        type: dictionaryType;
        yourself
}.


ParseTreeEnumDefinitionNode !{
analyzeAndEvaluateInEnvironment: (LexicalEnvironment)environment :: Value.
    let name := nameExpression analyzeAndEvaluateInEnvironment: environment withExpectedType: CompilationContext current SymbolType.
    let baseTypeValue := (baseType analyzeAndEvaluateInEnvironmentWithDecayedType: environment) asType.

    let enumType := EnumType new
        name: name asSymbolValue;
        baseType: baseTypeValue;
        yourself.
    environment setSymbol: name asSymbolValue binding: enumType.

    let enumValues := values analyzeAndEvaluateInEnvironment: environment withEnumBaseType: baseTypeValue.
    let enumValuesDictionary := enumValues asImmutableDictionaryValue.
    let namesAndValues := enumType namesAndValues.

    let i mutable := 0.
    let enumValueCount := enumValuesDictionary elements size.
    let nextImplicitBaseTypeValue mutable := baseTypeValue defaultValue.
    while: i < enumValueCount do: {
        let assoc := enumValuesDictionary elements at: i.
        let elementName := assoc key asSymbolValue.

        let elementValue mutable := assoc value.
        if: elementValue isUndefinedValue then: {
            elementValue := nextImplicitBaseTypeValue
        }.

        let enumValue := EnumValue new
            value: elementValue;
            name: elementName;
            type: enumType;
            yourself.
        namesAndValues at: elementName put: enumValue.

        nextImplicitBaseTypeValue := elementValue plusOne
    } continueWith: (i := i +1 ).

    enumType
}.

}